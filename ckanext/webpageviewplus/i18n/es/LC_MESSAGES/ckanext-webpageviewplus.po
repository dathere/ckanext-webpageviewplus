#: ckanext/webpageviewplus/actions.py:170 ckanext/webpageviewplus/plugin.py:179
msgid "Website"
msgstr "Sitio web"

#: ckanext/webpageviewplus/actions.py:263
msgid "Must be a whole number"
msgstr "Debe ser un número entero"

#: ckanext/webpageviewplus/actions.py:299
msgid "PDF view not found"
msgstr "No se encontró la vista PDF"

#: ckanext/webpageviewplus/actions.py:328
msgid "Thumbnails aren't enabled on this site"
msgstr "Las miniaturas no están activadas en este sitio"

#: ckanext/webpageviewplus/actions.py:338
#: ckanext/webpageviewplus/actions.py:341
msgid "Not a usable image"
msgstr "No es una imagen utilizable"

#: ckanext/webpageviewplus/plugin.py:157
msgid "Website (Plus)"
msgstr "Sitio web (Plus)"

#: ckanext/webpageviewplus/plugin.py:305
msgid "Embedded web page"
msgstr "Página web incrustada"

#: ckanext/webpageviewplus/plugin.py:511
msgid "PDF (Plus)"
msgstr "PDF (Plus)"

#: ckanext/webpageviewplus/plugin.py:524
msgid "PDF"
msgstr "PDF"

#: ckanext/webpageviewplus/plugin.py:581
msgid "PDF document"
msgstr "Documento PDF"

#: ckanext/webpageviewplus/validators.py:19
msgid "Web Page url must be an http:// or https:// URL"
msgstr "La URL de la página web debe ser una URL http:// o https://"

#: ckanext/webpageviewplus/validators.py:28
msgid "Preset is not one of the allowed presets"
msgstr "El perfil no es uno de los perfiles permitidos"

#: ckanext/webpageviewplus/validators.py:34
#: ckanext/webpageviewplus/validators.py:282
msgid "Unknown height mode"
msgstr "Modo de altura desconocido"

#: ckanext/webpageviewplus/validators.py:47
#, python-brace-format
msgid "Unknown sandbox token: {tokens}"
msgid_plural "Unknown sandbox tokens: {tokens}"
msgstr[0] "Token de sandbox desconocido: {tokens}"
msgstr[1] "Tokens de sandbox desconocidos: {tokens}"

#: ckanext/webpageviewplus/validators.py:62
#, python-brace-format
msgid "This feature can't be granted: {features}"
msgid_plural "These features can't be granted: {features}"
msgstr[0] "Esta función no se puede conceder: {features}"
msgstr[1] "Estas funciones no se pueden conceder: {features}"

#: ckanext/webpageviewplus/validators.py:70
msgid "Unknown referrer policy"
msgstr "Política de referrer desconocida"

#: ckanext/webpageviewplus/validators.py:131
msgid "A share of the window takes a number from 1 to 100"
msgstr "Una proporción de la ventana necesita un número del 1 al 100"

#: ckanext/webpageviewplus/validators.py:133
msgid "An aspect ratio takes width/height, such as 16/9"
msgstr "Una relación de aspecto necesita ancho/alto, como 16/9"

#: ckanext/webpageviewplus/validators.py:134
msgid "Fixed takes a number of pixels, such as 600"
msgstr "Fija necesita un número de píxeles, como 600"

#: ckanext/webpageviewplus/validators.py:179
msgid ""
"This page uses http://, which browsers block inside this https:// site. "
"Use its https:// address, or link to it instead"
msgstr ""
"Esta página usa http://, que los navegadores bloquean dentro de este "
"sitio https://. Use su dirección https:// o enlácela en su lugar"

# | msgid "" "{service}'s viewer fetches the file from its own servers, so it
# | can't " "show a file in a private dataset."
#: ckanext/webpageviewplus/validators.py:198
msgid ""
"Microsoft's viewer fetches the file from its own servers, so it can't "
"show a file in a private dataset"
msgstr ""
"El visor de Microsoft obtiene el archivo desde sus propios servidores, "
"así que no puede mostrar un archivo de un conjunto de datos privado"

#: ckanext/webpageviewplus/validators.py:220
msgid ""
"External is for third-party sites: uploaded HTML always gets a sandbox. "
"Use Data Schematic or Interactive"
msgstr ""
"Externo es para sitios de terceros: el HTML subido siempre lleva un "
"sandbox. Use Data Schematic o Interactivo"

#: ckanext/webpageviewplus/validators.py:233
#: ckanext/webpageviewplus/validators.py:312
msgid "This host isn't on the site's list of allowed hosts"
msgstr "Este host no está en la lista de hosts permitidos del sitio"

# | msgid "" "This frame can't let scripts keep a real origin: don't combine
# | allow-" "scripts with allow-same-origin. Pages on this site never may;
# other
# | pages" " may once uploaded HTML is served from a separate content origin"
#: ckanext/webpageviewplus/validators.py:246
msgid ""
"These settings could let the page use visitors' logins on this site: "
"don't combine allow-scripts with allow-same-origin. Pages on this site "
"never may; other pages may once the site has a separate domain for "
"uploads"
msgstr ""
"Esta configuración podría permitir que la página use las sesiones de los "
"visitantes en este sitio: no combine allow-scripts con allow-same-origin."
" Las páginas de este sitio nunca pueden; otras páginas pueden cuando el "
"sitio tenga un dominio aparte para los archivos subidos"

#: ckanext/webpageviewplus/validators.py:275
msgid "Choose an image from this dataset"
msgstr "Elija una imagen de este conjunto de datos"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:4
msgid "Strict: static HTML, no scripts"
msgstr "Estricto: HTML estático, sin scripts"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:5
msgid "Interactive: scripts, forms, popups and downloads, no storage"
msgstr ""
"Interactivo: scripts, formularios, ventanas emergentes y descargas, sin "
"almacenamiento"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:6
msgid "External: a trusted third-party site, no sandbox"
msgstr "Externo: un sitio de terceros de confianza, sin sandbox"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:7
msgid ""
"External: a trusted third-party site, no sandbox (runs as Interactive for"
" now)"
msgstr ""
"Externo: un sitio de terceros de confianza, sin sandbox (por ahora "
"funciona como Interactivo)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:8
msgid "Data Schematic: qsv Data Schematics"
msgstr "Data Schematic: Data Schematics de qsv"

#. how the embedded page's height is set; "Auto" means the page reports its own
#. height.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:12
msgid "Auto"
msgstr "Automática"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:13
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:7
msgid "Fixed (px)"
msgstr "Fija (px)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:14
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:8
msgid "Share of the window height, in percent"
msgstr "Proporción de la altura de la ventana, en porcentaje"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:15
msgid "Aspect ratio (e.g. 16/9)"
msgstr "Relación de aspecto (p. ej. 16/9)"

#. names of security presets, as in "the External preset".
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:20
msgid "Strict"
msgstr "Estricto"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:21
msgid "Interactive"
msgstr "Interactivo"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:22
msgid "External"
msgstr "Externo"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:23
msgid "Data Schematic"
msgstr "Data Schematic"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:29
msgid "Web Page url"
msgstr "URL de la página web"

# | msgid "eg. http://example.com  (if blank uses resource url)"
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:29
msgid "eg. https://example.com  (if blank uses resource url)"
msgstr "p. ej. https://example.com  (si se deja en blanco, usa la URL del recurso)"

# from
#. {services} is a comma-separated list of service names, such as "YouTube,
#. Vimeo,
#. Datawrapper".
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:32
msgid ""
"Leave blank to show this resource's own address. Paste a link from "
"{services} and the form suggests its embed address and settings."
msgstr ""
"Déjelo en blanco para mostrar la dirección del propio recurso. Pegue un "
"enlace de {services} y el formulario sugerirá su dirección de inserción y"
" la configuración que necesita."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:33
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:19
msgid "This site accepts pages from these hosts only: {hosts}."
msgstr "Este sitio solo acepta páginas de estos hosts: {hosts}."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:37
msgid ""
"This resource is a PDF: the PDF (Plus) view shows it better, on phones "
"too."
msgstr ""
"Este recurso es un PDF: la vista PDF (Plus) lo muestra mejor, también en "
"teléfonos."

# | msgid "" "{service} only works with the {preset} preset, which this site
# | runs as " "Interactive until it serves uploads from a separate content
# | origin, so it" " won't play here yet."
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:41
#, python-brace-format
msgid ""
"{service} only works with the {preset} preset, which this site runs as "
"Interactive until it has a separate domain for uploads, so it won't play "
"here yet. Ask your site administrator."
msgstr ""
"{service} solo funciona con el perfil {preset}, que este sitio ejecuta "
"como Interactivo hasta que tenga un dominio aparte para los archivos "
"subidos, así que aquí todavía no se reproducirá. Consulte al "
"administrador del sitio."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:42
#, python-brace-format
msgid ""
"{service} only works with the {preset} preset, which this site doesn't "
"allow."
msgstr "{service} solo funciona con el perfil {preset}, que este sitio no permite."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:43
#, python-brace-format
msgid ""
"{service} embeds come from {host}, which isn't on this site's list of "
"allowed hosts."
msgstr ""
"Los contenidos incrustados de {service} vienen de {host}, que no está en "
"la lista de hosts permitidos de este sitio."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:44
msgid ""
"{service}'s viewer fetches the file from its own servers, so it can't "
"show a file in a private dataset."
msgstr ""
"El visor de {service} obtiene el archivo desde sus propios servidores, "
"así que no puede mostrar un archivo de un conjunto de datos privado."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:45
msgid ""
"{service} doesn't let its pages show inside other sites, so this view "
"would stay blank. Use the page's embed or share address if it has one, or"
" link to it instead."
msgstr "{service} no permite que sus páginas se muestren dentro de otros sitios, así que esta vista quedaría en blanco. Use la dirección para insertar o compartir de la página, si la tiene, o enlace a ella."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:56
#, python-brace-format
msgid ""
"This is a {service} page. Use its embed address and the settings its "
"embed needs?"
msgstr ""
"Esta es una página de {service}. ¿Usar su dirección para incrustar y los "
"ajustes que necesita?"

#. a button accepting the suggested embed address and settings.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:58
msgid "Use them"
msgstr "Usarlos"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:59
#, python-brace-format
msgid ""
"Using the embed address and settings for {service}. Save the view to keep"
" them."
msgstr ""
"Usando la dirección para incrustar y los ajustes de {service}. Guarde la "
"vista para conservarlos."

# | msgid "" "This site refuses to be embedded ({reason}), so the view will
# show
# | an " "error. Consider linking to it instead."
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:73
#, python-brace-format
msgid ""
"This site refuses to be embedded, so the view will show an error. "
"Consider linking to it instead."
msgstr ""
"Este sitio no permite que se le incruste, así que la vista mostrará un "
"error. Considere enlazarlo en su lugar."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:74
msgid "Couldn't check whether this site allows embedding."
msgstr "No se pudo comprobar si este sitio permite que se le incruste."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:78
msgid "Security preset"
msgstr "Perfil de seguridad"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:87
msgid ""
"Choose the most restrictive preset that works: if the page stays blank or"
" broken, try the next one."
msgstr ""
"Elija el perfil más restrictivo que funcione: si la página queda en "
"blanco o falla, pruebe el siguiente."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:88
msgid "External turns the sandbox off, so use it only for sites you trust."
msgstr "Externo desactiva el sandbox, así que úselo solo con sitios de confianza."

# | msgid "" "This preset needs uploaded HTML to be served from a separate
# | content " "origin, which this site doesn't have yet, so the view runs as "
# | "Interactive."
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:95
msgid ""
"This preset needs a separate domain for uploads, which this site doesn't "
"have yet, so the view runs as Interactive. Ask your site administrator if"
" you need it."
msgstr ""
"Este perfil necesita un dominio aparte para los archivos subidos, que "
"este sitio aún no tiene, así que la vista funciona como Interactivo. "
"Consulte al administrador del sitio si lo necesita."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:96
msgid "Charts, the Tour and Explore work, but maps stay blank."
msgstr ""
"Los gráficos, el Tour y Explore funcionan, pero los mapas quedan en "
"blanco."

# | msgid "" "This view's sandbox would let scripts keep a real origin, which
# | isn't " "allowed here, so it runs as Strict."
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:100
msgid ""
"These sandbox settings could let the page use visitors' logins on this "
"site, which isn't allowed, so the view runs as Strict."
msgstr ""
"Esta configuración del sandbox podría permitir que la página use las "
"sesiones de los visitantes en este sitio, lo que no está permitido, así "
"que la vista funciona como Estricto."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:103
msgid ""
"In Chrome and Edge, this site loads pages with this preset without the "
"visitor's cookies or saved data, so logins inside the page and sign-in "
"popups won't work."
msgstr ""
"En Chrome y Edge, este sitio carga las páginas con este perfil sin las "
"cookies ni los datos guardados del visitante, así que no funcionarán los "
"inicios de sesión dentro de la página ni las ventanas emergentes de "
"inicio de sesión."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:107
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:24
msgid "Height"
msgstr "Altura"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:110
msgid "Preset's default"
msgstr "La del perfil"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:116
msgid ""
"Auto fits pages that report their own height, such as qsv Data "
"Schematics. Other pages keep a fixed fallback height."
msgstr ""
"Automática se ajusta a las páginas que informan de su propia altura, como"
" los Data Schematics de qsv. Las demás páginas mantienen una altura fija "
"de reserva."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:120
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:35
msgid "Height value"
msgstr "Valor de altura"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:120
msgid "eg. 600, 80 or 16/9"
msgstr "p. ej. 600, 80 o 16/9"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:121
msgid ""
"Pixels for Fixed, a number from 1 to 100 for a share of the window, or a "
"ratio such as 16/9. Auto and the preset's default need no value."
msgstr ""
"Píxeles para Fija, un número del 1 al 100 para una proporción de la "
"ventana o una relación como 16/9. Automática y La del perfil no necesitan"
" valor."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:126
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:41
msgid "Thumbnail in the resource list"
msgstr "Miniatura en la lista de recursos"

#. no thumbnail image chosen (the image, feminine in some languages).
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:130
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:45
msgid "None"
msgstr "Ninguna"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:137
msgid ""
"An image in this dataset (PNG, JPEG, WebP or GIF), uploaded or linked, "
"shown small beside this resource in the dataset's list. With None, the "
"page's own preview image, a well-known service's logo or the format icon "
"shows."
msgstr ""
"Una imagen de este conjunto de datos (PNG, JPEG, WebP o GIF), subida o "
"enlazada, que se muestra en pequeño junto a este recurso en la lista del "
"conjunto de datos. Con Ninguna, se muestra la imagen de vista previa de "
"la propia página, el logotipo de un servicio conocido o el icono del "
"formato."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:139
msgid ""
"An image uploaded to this dataset (PNG, JPEG, WebP or GIF), shown small "
"beside this resource in the dataset's list. With None, a well-known "
"service's logo or the format icon shows."
msgstr ""
"Una imagen subida a este conjunto de datos (PNG, JPEG, WebP o GIF), que "
"se muestra en pequeño junto a este recurso en la lista del conjunto de "
"datos. Con Ninguna, se muestra el logotipo de un servicio conocido o el "
"icono del formato."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:146
msgid "Don't make a thumbnail automatically"
msgstr "No crear una miniatura automáticamente"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:148
msgid ""
"Otherwise, when no image is chosen above, this site fetches the image the"
" page names for link previews, once when the view is saved, and shows a "
"small copy."
msgstr ""
"Si no, cuando no se elige ninguna imagen arriba, este sitio descarga la "
"imagen que la página indica para las vistas previas de enlaces, una vez "
"al guardar la vista, y muestra una copia pequeña."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:150
msgid ""
"Otherwise, when no image is chosen above, an Office file uploaded to this"
" dataset shows the preview picture saved inside it."
msgstr ""
"Si no, cuando no se elige ninguna imagen arriba, un archivo de Office "
"subido a este conjunto de datos muestra la imagen de vista previa "
"guardada en él."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:159
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:71
msgid "Hide the control bar (Open in new tab, Fullscreen, Reload)"
msgstr ""
"Ocultar la barra de controles (Abrir en una pestaña nueva, Pantalla "
"completa, Recargar)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:160
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:72
msgid ""
"On phones and at high zoom, Open in new tab still shows, so visitors can "
"always reach the page."
msgstr ""
"En teléfonos y con mucho zoom, Abrir en una pestaña nueva sigue visible, "
"para que los visitantes siempre puedan llegar a la página."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:164
msgid "Ask before loading a page from another site"
msgstr "Preguntar antes de cargar una página de otro sitio"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:165
msgid ""
"Visitors see a card naming the site, and nothing loads from it until they"
" choose Load. Uploads and pages on this site load as usual."
msgstr ""
"Los visitantes ven una tarjeta con el nombre del sitio y no se carga nada"
" de él hasta que eligen Cargar. Los archivos subidos y las páginas de "
"este sitio se cargan como siempre."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:170
msgid "Count visits (daily totals only, nothing about visitors; the view says so)"
msgstr ""
"Contar visitas (solo totales diarios, nada sobre los visitantes; la vista"
" lo indica)"

#. view counts as "label: number" pairs, so no plural forms are needed.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:176
#, python-brace-format
msgid ""
"Last 30 days. Shown: {impressions}. Seen: {seen}. Loaded: {loaded}. Used:"
" {engaged}. Failed: {failed}."
msgstr ""
"Últimos 30 días. Mostrada: {impressions}. Vista en pantalla: {seen}. "
"Cargada: {loaded}. Usada: {engaged}. Con error: {failed}."

#. heading of the advanced (sysadmin-only) settings.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:185
msgid "Advanced"
msgstr "Avanzado"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:186
msgid ""
"Each field replaces the preset's value; leave it blank to keep the "
"preset's. A sandbox with both allow-scripts and allow-same-origin is "
"refused wherever it could let a page act as this site."
msgstr ""
"Cada campo reemplaza el valor del perfil; déjelo en blanco para mantener "
"el del perfil. Un sandbox con allow-scripts y allow-same-origin a la vez "
"se rechaza siempre que pudiera permitir a una página actuar como este "
"sitio."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:187
msgid "Sandbox tokens (replace the preset's)"
msgstr "Tokens de sandbox (reemplazan los del perfil)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:187
msgid "eg. allow-scripts allow-popups"
msgstr "p. ej. allow-scripts allow-popups"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:188
msgid "Allowed features (replace the preset's)"
msgstr "Funciones permitidas (reemplazan las del perfil)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:188
msgid "eg. fullscreen; clipboard-write"
msgstr "p. ej. fullscreen; clipboard-write"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:190
msgid "Referrer policy"
msgstr "Política de referrer"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:193
msgid "Site default"
msgstr "La del sitio"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:12
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:144
msgid ""
"This PDF can't be shown: the site needs a separate domain for uploaded "
"content."
msgstr ""
"Este PDF no se puede mostrar: el sitio necesita un dominio aparte para el"
" contenido subido."

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:15
msgid "PDF url"
msgstr "URL del PDF"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:15
msgid "eg. https://example.com/report.pdf  (if blank uses resource url)"
msgstr ""
"p. ej. https://example.com/report.pdf  (si está vacío, se usa la URL del "
"recurso)"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:17
msgid ""
"Leave blank to show this resource's own file. A PDF on another site is "
"fetched by this site and shown from here, so visitors never contact that "
"site."
msgstr ""
"Déjelo vacío para mostrar el archivo de este recurso. Un PDF de otro "
"sitio lo descarga este sitio y se muestra desde aquí, así que los "
"visitantes nunca contactan con ese sitio."

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:18
msgid "Files on other sites are shown up to {size} MB."
msgstr "Los archivos de otros sitios se muestran hasta {size} MB."

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:35
msgid "eg. 800 or 80"
msgstr "p. ej. 800 u 80"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:36
msgid ""
"Pixels for Fixed, or a number from 1 to 100 for a share of the window. "
"Blank is 800 pixels."
msgstr ""
"Píxeles para Fija, o un número del 1 al 100 para una parte de la ventana."
" Vacío son 800 píxeles."

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:46
msgid "The PDF's first page"
msgstr "La primera página del PDF"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:52
msgid ""
"An image in this dataset (PNG, JPEG, WebP or GIF), shown small beside "
"this resource in the dataset's list. With None, the format icon shows."
msgstr ""
"Una imagen de este conjunto de datos (PNG, JPEG, WebP o GIF), mostrada en"
" pequeño junto a este recurso en la lista del conjunto. Con Ninguna, se "
"muestra el icono del formato."

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:53
msgid ""
"The PDF's first page is drawn in your browser when you choose it, and "
"again when you edit the view after an uploaded file has changed, or every"
" time for a PDF linked from another site."
msgstr ""
"La primera página del PDF se dibuja en su navegador al elegirla, y de "
"nuevo al editar la vista después de que un archivo subido haya cambiado, "
"o cada vez si el PDF está enlazado desde otro sitio."

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:60
msgid "Drawing the first page…"
msgstr "Dibujando la primera página…"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:61
msgid "The first page is ready. Save the view to use it."
msgstr "La primera página está lista. Guarde la vista para usarla."

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:62
msgid ""
"Couldn't draw the first page. Check the PDF shows in the view, then try "
"again."
msgstr ""
"No se pudo dibujar la primera página. Compruebe que el PDF se ve en la "
"vista e inténtelo de nuevo."

# | msgid "Save the view first, then choose the first page again."
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:63
msgid "Save the view, then edit it again to draw the first page."
msgstr "Guarde la vista y luego vuelva a editarla para dibujar la primera página."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:8
msgid ""
"This page can't be shown here: it's served over http://, which browsers "
"block inside https:// sites."
msgstr ""
"Esta página no se puede mostrar aquí: se sirve por http://, que los "
"navegadores bloquean dentro de sitios https://."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:10
msgid ""
"This page is gone: {host} said it no longer exists when the view was last"
" checked."
msgstr ""
"Esta página ya no existe: {host} indicó que ya no existía la última vez "
"que se comprobó la vista."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:12
msgid ""
"Microsoft's viewer can't open files in a private dataset, so this view "
"can't show it."
msgstr ""
"El visor de Microsoft no puede abrir archivos de un conjunto de datos "
"privado, así que esta vista no puede mostrarlo."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:14
#, python-brace-format
msgid "{host} doesn't allow its pages to be shown inside other sites."
msgstr "{host} no permite que sus páginas se muestren dentro de otros sitios."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:17
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:114
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:140
msgid "Open in new tab"
msgstr "Abrir en una pestaña nueva"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:28
msgid "Skip embedded content"
msgstr "Saltar el contenido incrustado"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:33
#, python-brace-format
msgid "Interact with {title}"
msgstr "Interactuar con {title}"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:33
msgid "Tap to interact"
msgstr "Toque para interactuar"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:59
#, python-brace-format
msgid "This view loads content from {host}."
msgstr "Esta vista carga contenido de {host}."

# it
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:61
msgid ""
"Loading it lets {host} know you are visiting this site, and it may "
"recognise you if you are signed in there."
msgstr ""
"Al cargarlo, {host} sabrá que está visitando este sitio y puede "
"reconocerle si tiene la sesión iniciada allí."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:62
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:107
msgid "Privacy policy"
msgstr "Política de privacidad"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:65
msgid "Not loaded, to save data."
msgstr "No se ha cargado, para ahorrar datos."

#. a button loading the embedded page; {size} is its file size, e.g. "1.2 MB".
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:69
#, python-brace-format
msgid "Load ({size})"
msgstr "Cargar ({size})"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:69
msgid "Load"
msgstr "Cargar"

#. a button that loads the page and remembers, in this browser, to load pages
#. from
#. {host} without asking.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:74
#, python-brace-format
msgid "Always load from {host}"
msgstr "Cargar siempre desde {host}"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:81
msgid "Content from {host} loads without asking in this browser."
msgstr "El contenido de {host} se carga sin preguntar en este navegador."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:83
msgid "You will be asked again next time."
msgstr "Se le volverá a preguntar la próxima vez."

#. a button that forgets the choice to always load pages from a site.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:85
msgid "Ask me again"
msgstr "Volver a preguntar"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:97
#, python-brace-format
msgid "{title} loaded"
msgstr "Se ha cargado {title}"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:100
msgid "This page connects to"
msgstr "Esta página se conecta a"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:106
msgid "This view counts visits."
msgstr "Esta vista cuenta las visitas."

#. accessible name of the toolbar under an embedded web page.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:112
msgid "Embedded page"
msgstr "Página incrustada"

#. "Expand" makes the embedded page fill the window; "Fullscreen" fills the
#. screen.
#. Buttons.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:121
msgid "Expand"
msgstr "Ampliar"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:121
msgid "Fullscreen"
msgstr "Pantalla completa"

#. a button leaving the expanded (full-window) view.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:123
msgid "Close"
msgstr "Cerrar"

#. a button reloading the embedded page.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:127
msgid "Reload"
msgstr "Recargar"

#. a button opening the device's share sheet for this page.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:133
msgid "Share"
msgstr "Compartir"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:146
msgid ""
"There is no PDF to show: only uploaded files and http:// or https:// "
"links are supported."
msgstr ""
"No hay ningún PDF que mostrar: solo se admiten archivos subidos y enlaces"
" http:// o https://."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:148
msgid "Save the view to see the PDF."
msgstr "Guarde la vista para ver el PDF."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:150
msgid ""
"This page can't be embedded: its host isn't on this site's list of "
"allowed hosts."
msgstr ""
"Esta página no se puede incrustar: su host no está en la lista de hosts "
"permitidos de este sitio."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:152
msgid ""
"This page cannot be embedded: only http:// and https:// URLs are "
"supported."
msgstr "Esta página no se puede incrustar: solo se admiten URL http:// y https://."

