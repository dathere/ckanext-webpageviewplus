#: ckanext/webpageviewplus/actions.py:156
msgid "Must be a whole number"
msgstr "Deve ser um número inteiro"

#: ckanext/webpageviewplus/plugin.py:138
msgid "Website (Plus)"
msgstr "Site (Plus)"

#: ckanext/webpageviewplus/plugin.py:157
msgid "Website"
msgstr "Site"

#: ckanext/webpageviewplus/plugin.py:252
msgid "Embedded web page"
msgstr "Página web incorporada"

#: ckanext/webpageviewplus/validators.py:19
msgid "Web Page url must be an http:// or https:// URL"
msgstr "A URL da página web deve ser uma URL http:// ou https://"

#: ckanext/webpageviewplus/validators.py:28
msgid "Preset is not one of the allowed presets"
msgstr "O perfil não é um dos perfis permitidos"

#: ckanext/webpageviewplus/validators.py:34
msgid "Unknown height mode"
msgstr "Modo de altura desconhecido"

#: ckanext/webpageviewplus/validators.py:47
#, python-brace-format
msgid "Unknown sandbox token: {tokens}"
msgid_plural "Unknown sandbox tokens: {tokens}"
msgstr[0] "Token de sandbox desconhecido: {tokens}"
msgstr[1] "Tokens de sandbox desconhecidos: {tokens}"

#: ckanext/webpageviewplus/validators.py:62
#, python-brace-format
msgid "This feature can't be granted: {features}"
msgid_plural "These features can't be granted: {features}"
msgstr[0] "Esta funcionalidade não pode ser concedida: {features}"
msgstr[1] "Estas funcionalidades não podem ser concedidas: {features}"

#: ckanext/webpageviewplus/validators.py:70
msgid "Unknown referrer policy"
msgstr "Política de referenciador desconhecida"

#: ckanext/webpageviewplus/validators.py:131
msgid "Height value doesn't fit the height mode"
msgstr "O valor da altura não corresponde ao modo de altura"

#: ckanext/webpageviewplus/validators.py:158
msgid ""
"External is for third-party sites: uploaded HTML always gets a sandbox. Use "
"Data Schematic or Interactive"
msgstr ""
"Externo é para sites de terceiros: o HTML enviado sempre recebe um sandbox. "
"Use Data Schematic ou Interativo"

#: ckanext/webpageviewplus/validators.py:171
msgid "This host isn't on the site's list of allowed hosts"
msgstr "Este host não está na lista de hosts permitidos do site"

#: ckanext/webpageviewplus/validators.py:184
msgid ""
"This frame can't let scripts keep a real origin: don't combine allow-scripts "
"with allow-same-origin. Pages on this site never may; other pages may once "
"uploaded HTML is served from a separate content origin"
msgstr ""
"Este quadro não pode deixar scripts manterem uma origem real: não combine "
"allow-scripts com allow-same-origin. Páginas deste site nunca podem; outras "
"páginas podem quando o HTML enviado for servido a partir de uma origem de "
"conteúdo separada"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:4
msgid "Strict: static HTML, no scripts"
msgstr "Estrito: HTML estático, sem scripts"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:5
msgid "Interactive: scripts, popups and downloads, no storage"
msgstr "Interativo: scripts, pop-ups e downloads, sem armazenamento"

# | msgid "" "External: a trusted third-party site, no sandbox (runs as
# | Interactive for" " now)"
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:6
msgid "External: a trusted third-party site, no sandbox"
msgstr "Externo: um site de terceiros confiável, sem sandbox"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:7
msgid "External: a trusted third-party site, no sandbox (runs as Interactive for now)"
msgstr ""
"Externo: um site de terceiros confiável, sem sandbox (por enquanto funciona "
"como Interativo)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:8
msgid "Data Schematic: qsv Data Schematics"
msgstr "Data Schematic: Data Schematics do qsv"

#. how the embedded page's height is set; "Auto" means the page reports its own
#. height.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:12
msgid "Auto"
msgstr "Automática"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:13
msgid "Fixed (px)"
msgstr "Fixa (px)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:14
msgid "Share of the window height, in percent"
msgstr "Parte da altura da janela, em porcentagem"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:15
msgid "Aspect ratio (e.g. 16/9)"
msgstr "Proporção (ex.: 16/9)"

#. names of security presets, as in "the External preset".
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:20
msgid "Strict"
msgstr "Estrito"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:21
msgid "Interactive"
msgstr "Interativo"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:22
msgid "External"
msgstr "Externo"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:23
msgid "Data Schematic"
msgstr "Data Schematic"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:27
msgid "Web Page url"
msgstr "URL da página web"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:27
msgid "eg. http://example.com  (if blank uses resource url)"
msgstr "ex.: http://example.com  (se vazio, usa a URL do recurso)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:35
#, python-brace-format
msgid ""
"This is a {service} page. Use its embed address and the settings its embed "
"needs?"
msgstr ""
"Esta é uma página de {service}. Usar o endereço de incorporação e as "
"configurações de que ela precisa?"

#. a button accepting the suggested embed address and settings.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:37
msgid "Use them"
msgstr "Usar"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:38
#, python-brace-format
msgid ""
"Using the embed address and settings for {service}. Save the view to keep "
"them."
msgstr ""
"Usando o endereço de incorporação e as configurações de {service}. Salve a "
"visualização para mantê-los."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:39
#, python-brace-format
msgid ""
"{service} only works with the {preset} preset, which this site runs as "
"Interactive until it serves uploads from a separate content origin, so it "
"won't play here yet."
msgstr ""
"{service} só funciona com o perfil {preset}, que este site executa como "
"Interativo até servir os arquivos enviados a partir de uma origem de conteúdo"
" separada; por isso, ainda não vai reproduzir aqui."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:40
#, python-brace-format
msgid "{service} only works with the {preset} preset, which this site doesn't allow."
msgstr "{service} só funciona com o perfil {preset}, que este site não permite."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:41
#, python-brace-format
msgid ""
"{service} embeds come from {host}, which isn't on this site's list of allowed"
" hosts."
msgstr ""
"As incorporações de {service} vêm de {host}, que não está na lista de hosts "
"permitidos deste site."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:47
#, python-brace-format
msgid ""
"This site refuses to be embedded ({reason}), so the view will show an error. "
"Consider linking to it instead."
msgstr ""
"Este site não permite ser incorporado ({reason}), então a visualização "
"mostrará um erro. Considere colocar um link para ele."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:48
msgid "Couldn't check whether this site allows embedding."
msgstr "Não foi possível verificar se este site permite ser incorporado."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:52
msgid "Security preset"
msgstr "Perfil de segurança"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:65
msgid ""
"This preset needs uploaded HTML to be served from a separate content origin, "
"which this site doesn't have yet, so the view runs as Interactive."
msgstr ""
"Este perfil precisa que o HTML enviado seja servido a partir de uma origem de"
" conteúdo separada, que este site ainda não tem; por isso, a visualização "
"funciona como Interativo."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:66
msgid "Charts, the Tour and Explore work, but maps stay blank."
msgstr "Os gráficos, o Tour e o Explore funcionam, mas os mapas ficam em branco."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:70
msgid ""
"This view's sandbox would let scripts keep a real origin, which isn't allowed"
" here, so it runs as Strict."
msgstr ""
"O sandbox desta visualização deixaria scripts manterem uma origem real, o que"
" não é permitido aqui; por isso, ela funciona como Estrito."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:73
msgid ""
"In Chrome and Edge, this site loads pages with this preset without the "
"visitor's cookies or saved data, so logins inside the page and sign-in popups"
" won't work."
msgstr ""
"No Chrome e no Edge, este site carrega páginas com este perfil sem os cookies"
" nem os dados salvos do visitante, então logins dentro da página e pop-ups de"
" login não vão funcionar."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:77
msgid "Height"
msgstr "Altura"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:80
msgid "Preset's default"
msgstr "A do perfil"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:89
msgid "Height value"
msgstr "Valor da altura"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:89
msgid "eg. 600, 80 or 16/9"
msgstr "ex.: 600, 80 ou 16/9"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:94
msgid "Hide the control bar (Open in new tab, Fullscreen, Reload)"
msgstr "Ocultar a barra de controles (Abrir em nova aba, Tela cheia, Recarregar)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:98
msgid "Ask before loading a page from another site"
msgstr "Perguntar antes de carregar uma página de outro site"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:103
msgid "Count visits (daily totals only, nothing about visitors; the view says so)"
msgstr ""
"Contar visitas (somente totais diários, nada sobre os visitantes; a "
"visualização avisa)"

#. view counts as "label: number" pairs, so no plural forms are needed.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:109
#, python-brace-format
msgid ""
"Last 30 days. Shown: {impressions}. Seen: {seen}. Loaded: {loaded}. Used: "
"{engaged}. Failed: {failed}."
msgstr ""
"Últimos 30 dias. Exibida: {impressions}. Vista na tela: {seen}. Carregada: "
"{loaded}. Usada: {engaged}. Com falha: {failed}."

#. heading of the advanced (sysadmin-only) settings.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:118
msgid "Advanced"
msgstr "Avançado"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:119
msgid "Sandbox tokens (replace the preset's)"
msgstr "Tokens de sandbox (substituem os do perfil)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:119
msgid "eg. allow-scripts allow-popups"
msgstr "ex.: allow-scripts allow-popups"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:120
msgid "Allowed features (replace the preset's)"
msgstr "Funcionalidades permitidas (substituem as do perfil)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:120
msgid "eg. fullscreen; clipboard-write"
msgstr "ex.: fullscreen; clipboard-write"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:122
msgid "Referrer policy"
msgstr "Política de referenciador"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:125
msgid "Site default"
msgstr "A do site"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:8
msgid ""
"This page can't be shown here: it's served over http://, which browsers block"
" inside https:// sites."
msgstr ""
"Esta página não pode ser exibida aqui: ela é servida por http://, que os "
"navegadores bloqueiam dentro de sites https://."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:10
#, python-brace-format
msgid "{host} doesn't allow its pages to be shown inside other sites."
msgstr "{host} não permite que suas páginas sejam exibidas dentro de outros sites."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:13
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:89
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:115
msgid "Open in new tab"
msgstr "Abrir em nova aba"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:24
msgid "Skip embedded content"
msgstr "Pular o conteúdo incorporado"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:29
#, python-brace-format
msgid "Interact with {title}"
msgstr "Interagir com {title}"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:29
msgid "Tap to interact"
msgstr "Toque para interagir"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:54
#, python-brace-format
msgid "This view loads content from {host}."
msgstr "Esta visualização carrega conteúdo de {host}."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:56
msgid "Not loaded, to save data."
msgstr "Não carregado, para economizar dados."

#. a button loading the embedded page; {size} is its file size, e.g. "1.2 MB".
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:60
#, python-brace-format
msgid "Load ({size})"
msgstr "Carregar ({size})"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:60
msgid "Load"
msgstr "Carregar"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:72
#, python-brace-format
msgid "{title} loaded"
msgstr "{title}: carregamento concluído"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:75
msgid "This page connects to"
msgstr "Esta página se conecta a"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:81
msgid "This view counts visits."
msgstr "Esta visualização conta visitas."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:82
msgid "Privacy policy"
msgstr "Política de privacidade"

#. accessible name of the toolbar under an embedded web page.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:87
msgid "Embedded page"
msgstr "Página incorporada"

#. "Expand" makes the embedded page fill the window; "Fullscreen" fills the
#. screen.
#. Buttons.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:96
msgid "Expand"
msgstr "Expandir"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:96
msgid "Fullscreen"
msgstr "Tela cheia"

#. a button leaving the expanded (full-window) view.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:98
msgid "Close"
msgstr "Fechar"

#. a button reloading the embedded page.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:102
msgid "Reload"
msgstr "Recarregar"

#. a button opening the device's share sheet for this page.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:108
msgid "Share"
msgstr "Compartilhar"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:119
msgid ""
"This page can't be embedded: its host isn't on this site's list of allowed "
"hosts."
msgstr ""
"Esta página não pode ser incorporada: o host dela não está na lista de hosts "
"permitidos deste site."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:121
msgid "This page cannot be embedded: only http:// and https:// URLs are supported."
msgstr ""
"Esta página não pode ser incorporada: somente URLs http:// e https:// são "
"suportadas."

