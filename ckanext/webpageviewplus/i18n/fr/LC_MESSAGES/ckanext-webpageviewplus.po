#: ckanext/webpageviewplus/actions.py:179 ckanext/webpageviewplus/plugin.py:189
msgid "Website"
msgstr "Site web"

#: ckanext/webpageviewplus/actions.py:275
msgid "Must be a whole number"
msgstr "Doit être un nombre entier"

#: ckanext/webpageviewplus/actions.py:311
msgid "PDF view not found"
msgstr "Vue PDF introuvable"

#: ckanext/webpageviewplus/actions.py:340
msgid "Thumbnails aren't enabled on this site"
msgstr "Les miniatures ne sont pas activées sur ce site"

#: ckanext/webpageviewplus/actions.py:350
#: ckanext/webpageviewplus/actions.py:353
msgid "Not a usable image"
msgstr "Image inutilisable"

#: ckanext/webpageviewplus/actions.py:403 ckanext/webpageviewplus/manage.py:325
msgid "This site takes screenshots on a schedule, not on request."
msgstr "Ce site prend des captures d'écran selon un calendrier, pas à la demande."

#: ckanext/webpageviewplus/actions.py:407 ckanext/webpageviewplus/manage.py:598
msgid "This view's page doesn't get a screenshot."
msgstr "La page de cette vue ne reçoit pas de capture d'écran."

#: ckanext/webpageviewplus/actions.py:413 ckanext/webpageviewplus/manage.py:599
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:219
msgid "The screenshot couldn't be queued. Try again later."
msgstr "La capture n'a pas pu être mise en file d'attente. Réessayez plus tard."

#: ckanext/webpageviewplus/actions.py:417 ckanext/webpageviewplus/manage.py:593
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:222
#: ckanext/webpageviewplus/thumbnail_templates/webpageviewplus/manage_dataset.html:95
#, python-brace-format
msgid "You can take a new screenshot in {seconds} second."
msgid_plural "You can take a new screenshot in {seconds} seconds."
msgstr[0] "Vous pourrez prendre une nouvelle capture dans {seconds} seconde."
msgstr[1] "Vous pourrez prendre une nouvelle capture dans {seconds} secondes."

# | msgid "Must be a whole number"
#: ckanext/webpageviewplus/manage.py:211 ckanext/webpageviewplus/manage.py:213
msgid "Must be a whole number."
msgstr "Doit être un nombre entier."

#: ckanext/webpageviewplus/manage.py:241
msgid "Unknown filter."
msgstr "Filtre inconnu."

# | msgid "Height value"
#: ckanext/webpageviewplus/manage.py:279 ckanext/webpageviewplus/manage.py:282
msgid "Missing value"
msgstr "Valeur manquante"

#: ckanext/webpageviewplus/manage.py:284
#, python-brace-format
msgid "At most {count} views at a time."
msgstr "Au plus {count} vues à la fois."

#: ckanext/webpageviewplus/manage.py:444
#, python-brace-format
msgid ""
"No worker reads the {queue} queue, so remakes can't be queued. Remake one"
" view at a time, or run ckan webpageviewplus check-views."
msgstr ""
"Aucun worker ne lit la file {queue}, les régénérations ne peuvent donc "
"pas être mises en file. Régénérez les vues une par une, ou lancez ckan "
"webpageviewplus check-views."

#: ckanext/webpageviewplus/manage.py:478
msgid "Unknown value."
msgstr "Valeur inconnue."

# | msgid "PDF view not found"
#: ckanext/webpageviewplus/manage.py:511 ckanext/webpageviewplus/manage.py:517
msgid "Dataset not found"
msgstr "Jeu de données introuvable"

#: ckanext/webpageviewplus/manage.py:513 ckanext/webpageviewplus/manage.py:572
msgid "Not authorized to see this page"
msgstr "Vous n'êtes pas autorisé à voir cette page"

# | msgid "PDF view not found"
#: ckanext/webpageviewplus/manage.py:554
msgid "View not found"
msgstr "Vue introuvable"

# | msgid "" "A screenshot will be taken in the background. Reload this form
# | later to " "see it."
#: ckanext/webpageviewplus/manage.py:588
msgid ""
"A screenshot will be taken in the background. Reload this page later to "
"see it."
msgstr ""
"Une capture d'écran sera prise en arrière-plan. Rechargez cette page plus"
" tard pour la voir."

#: ckanext/webpageviewplus/manage.py:604
msgid "The thumbnail was remade."
msgstr "La miniature a été régénérée."

#: ckanext/webpageviewplus/manage.py:605
msgid "The thumbnail couldn't be remade, so the last one is kept."
msgstr "La miniature n'a pas pu être régénérée, la précédente est donc conservée."

#: ckanext/webpageviewplus/manage.py:606
msgid "There's nothing to make a thumbnail from."
msgstr "Il n'y a rien à partir de quoi créer une miniature."

# | msgid "The first page is ready. Save the view to use it."
#: ckanext/webpageviewplus/manage.py:607
msgid "Draw the first page again in the view's form."
msgstr "Redessinez la première page dans le formulaire de la vue."

# | msgid "The repository couldn't be loaded. Try again later."
#: ckanext/webpageviewplus/manage.py:608
msgid "The thumbnail couldn't be remade. Try again later."
msgstr "La miniature n'a pas pu être régénérée. Réessayez plus tard."

#: ckanext/webpageviewplus/manage.py:613
msgid ""
"Removed. Unless automatic thumbnails are off, a new one is made at the "
"next save or refresh."
msgstr ""
"Supprimé. Sauf si les miniatures automatiques sont désactivées, une "
"nouvelle est créée au prochain enregistrement ou rafraîchissement."

#: ckanext/webpageviewplus/manage.py:615
msgid "There was nothing to remove."
msgstr "Il n'y avait rien à supprimer."

#: ckanext/webpageviewplus/manage.py:621
msgid "Pick one of this dataset's images."
msgstr "Choisissez l'une des images de ce jeu de données."

#: ckanext/webpageviewplus/manage.py:623
msgid "The thumbnail choice is saved."
msgstr "Le choix de miniature est enregistré."

#: ckanext/webpageviewplus/manage.py:628
msgid "Automatic thumbnails are off for this view."
msgstr "Les miniatures automatiques sont désactivées pour cette vue."

# | msgid "Thumbnails aren't enabled on this site"
#: ckanext/webpageviewplus/manage.py:629
msgid "Automatic thumbnails are on for this view."
msgstr "Les miniatures automatiques sont activées pour cette vue."

#: ckanext/webpageviewplus/manage.py:630
msgid "Unknown action."
msgstr "Action inconnue."

#: ckanext/webpageviewplus/plugin.py:167
msgid "Website (Plus)"
msgstr "Site web (Plus)"

#: ckanext/webpageviewplus/plugin.py:336
msgid "Embedded web page"
msgstr "Page web intégrée"

#: ckanext/webpageviewplus/plugin.py:576
msgid "PDF (Plus)"
msgstr "PDF (Plus)"

#: ckanext/webpageviewplus/plugin.py:589
msgid "PDF"
msgstr "PDF"

#: ckanext/webpageviewplus/plugin.py:646
msgid "PDF document"
msgstr "Document PDF"

#: ckanext/webpageviewplus/plugin.py:754
msgid "Repository (Plus)"
msgstr "Dépôt (Plus)"

#: ckanext/webpageviewplus/plugin.py:765 ckanext/webpageviewplus/plugin.py:802
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:6
msgid "Repository"
msgstr "Dépôt"

#: ckanext/webpageviewplus/validators.py:19
msgid "Web Page url must be an http:// or https:// URL"
msgstr "L’URL de la page web doit être une URL http:// ou https://"

#: ckanext/webpageviewplus/validators.py:28
msgid "Preset is not one of the allowed presets"
msgstr "Ce profil ne fait pas partie des profils autorisés"

#: ckanext/webpageviewplus/validators.py:34
#: ckanext/webpageviewplus/validators.py:282
msgid "Unknown height mode"
msgstr "Mode de hauteur inconnu"

#: ckanext/webpageviewplus/validators.py:47
#, python-brace-format
msgid "Unknown sandbox token: {tokens}"
msgid_plural "Unknown sandbox tokens: {tokens}"
msgstr[0] "Jeton de sandbox inconnu : {tokens}"
msgstr[1] "Jetons de sandbox inconnus : {tokens}"

#: ckanext/webpageviewplus/validators.py:62
#, python-brace-format
msgid "This feature can't be granted: {features}"
msgid_plural "These features can't be granted: {features}"
msgstr[0] "Cette fonctionnalité ne peut pas être accordée : {features}"
msgstr[1] "Ces fonctionnalités ne peuvent pas être accordées : {features}"

#: ckanext/webpageviewplus/validators.py:70
msgid "Unknown referrer policy"
msgstr "Politique de référent inconnue"

#: ckanext/webpageviewplus/validators.py:131
msgid "A share of the window takes a number from 1 to 100"
msgstr "Une part de la fenêtre demande un nombre de 1 à 100"

#: ckanext/webpageviewplus/validators.py:133
msgid "An aspect ratio takes width/height, such as 16/9"
msgstr "Un rapport d’aspect demande largeur/hauteur, comme 16/9"

#: ckanext/webpageviewplus/validators.py:134
msgid "Fixed takes a number of pixels, such as 600"
msgstr "Fixe demande un nombre de pixels, comme 600"

#: ckanext/webpageviewplus/validators.py:179
msgid ""
"This page uses http://, which browsers block inside this https:// site. "
"Use its https:// address, or link to it instead"
msgstr ""
"Cette page utilise http://, que les navigateurs bloquent dans ce site "
"https://. Utilisez son adresse https://, ou mettez plutôt un lien vers "
"elle"

# | msgid "" "{service}'s viewer fetches the file from its own servers, so it
# | can't " "show a file in a private dataset."
#: ckanext/webpageviewplus/validators.py:198
msgid ""
"Microsoft's viewer fetches the file from its own servers, so it can't "
"show a file in a private dataset"
msgstr ""
"La visionneuse de Microsoft récupère le fichier depuis ses propres "
"serveurs : elle ne peut donc pas afficher un fichier d'un jeu de données "
"privé"

#: ckanext/webpageviewplus/validators.py:219
msgid ""
"External is for third-party sites: uploaded HTML always gets a sandbox. "
"Use Data Schematic or Interactive"
msgstr ""
"Externe est réservé aux sites tiers : le HTML téléversé reçoit toujours "
"un sandbox. Utilisez Data Schematic ou Interactif"

#: ckanext/webpageviewplus/validators.py:232
#: ckanext/webpageviewplus/validators.py:312
msgid "This host isn't on the site's list of allowed hosts"
msgstr "Cet hôte ne figure pas dans la liste des hôtes autorisés du site"

# | msgid "" "This frame can't let scripts keep a real origin: don't combine
# | allow-" "scripts with allow-same-origin. Pages on this site never may;
# other
# | pages" " may once uploaded HTML is served from a separate content origin"
# | msgid "" "These settings could let the page use visitors' logins on this
# | site: " "don't combine allow-scripts with allow-same-origin. Pages on this
# | site " "never may; other pages may once the site has a separate domain for
# "
# | "uploads"
#: ckanext/webpageviewplus/validators.py:246
msgid ""
"These settings could let the page use visitors' logins on this site: "
"don't combine allow-scripts with allow-same-origin. Pages on this site "
"and uploads never may; other pages may once the site sandboxes downloads "
"(harden_downloads)"
msgstr ""
"Ces réglages pourraient laisser la page utiliser les connexions des "
"visiteurs sur ce site : ne combinez pas allow-scripts et allow-same-"
"origin. Les pages de ce site et les fichiers téléversés ne le peuvent "
"jamais ; les autres le peuvent une fois que le site met les "
"téléchargements en bac à sable (harden_downloads)"

#: ckanext/webpageviewplus/validators.py:275
msgid "Choose an image from this dataset"
msgstr "Choisissez une image de ce jeu de données"

# | msgid "" "There is no repository to show: only public GitHub repositories,
# | such as " "https://github.com/ckan/ckan, are supported."
#. TRANSLATORS: {hosts} is a list of this site's own Git servers.
#: ckanext/webpageviewplus/validators.py:342
#, python-brace-format
msgid ""
"Not the address of a repository on GitHub, GitLab, Codeberg, Bitbucket or"
" {hosts}, such as https://github.com/ckan/ckan"
msgstr ""
"Ce n'est pas l'adresse d'un dépôt sur GitHub, GitLab, Codeberg, Bitbucket"
" ou {hosts}, comme https://github.com/ckan/ckan"

# | msgid "Not a GitHub repository's address, such as
# | https://github.com/ckan/ckan"
#: ckanext/webpageviewplus/validators.py:346
msgid ""
"Not the address of a repository on GitHub, GitLab, Codeberg or Bitbucket,"
" such as https://github.com/ckan/ckan"
msgstr ""
"Ce n'est pas l'adresse d'un dépôt sur GitHub, GitLab, Codeberg ou "
"Bitbucket, comme https://github.com/ckan/ckan"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:4
msgid "Strict: static HTML, no scripts"
msgstr "Strict : HTML statique, sans scripts"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:5
msgid "Interactive: scripts, forms, popups and downloads, no storage"
msgstr ""
"Interactif : scripts, formulaires, fenêtres surgissantes et "
"téléchargements, sans stockage"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:6
msgid "External: a trusted third-party site, no sandbox"
msgstr "Externe : un site tiers de confiance, sans sandbox"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:7
msgid ""
"External: a trusted third-party site, no sandbox (runs as Interactive for"
" now)"
msgstr ""
"Externe : un site tiers de confiance, sans sandbox (fonctionne comme "
"Interactif pour l’instant)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:8
msgid "Data Schematic: qsv Data Schematics"
msgstr "Data Schematic : Data Schematics de qsv"

#. how the embedded page's height is set; "Auto" means the page reports its own
#. height.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:12
msgid "Auto"
msgstr "Automatique"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:13
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:7
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:7
msgid "Fixed (px)"
msgstr "Fixe (px)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:14
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:8
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:8
msgid "Share of the window height, in percent"
msgstr "Part de la hauteur de la fenêtre, en pourcentage"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:15
msgid "Aspect ratio (e.g. 16/9)"
msgstr "Format d’image (p. ex. 16/9)"

#. names of security presets, as in "the External preset".
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:20
msgid "Strict"
msgstr "Strict"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:21
msgid "Interactive"
msgstr "Interactif"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:22
msgid "External"
msgstr "Externe"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:23
msgid "Data Schematic"
msgstr "Data Schematic"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:29
msgid "Web Page url"
msgstr "URL de la page web"

# | msgid "eg. http://example.com  (if blank uses resource url)"
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:29
msgid "eg. https://example.com  (if blank uses resource url)"
msgstr "p. ex. https://example.com  (si vide, l’URL de la ressource est utilisée)"

# from
#. {services} is a comma-separated list of service names, such as "YouTube,
#. Vimeo,
#. Datawrapper".
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:32
#, python-brace-format
msgid ""
"Leave blank to show this resource's own address. Paste a link from "
"{services} and the form suggests its embed address and settings."
msgstr ""
"Laissez vide pour afficher l’adresse de la ressource elle-même. Collez un"
" lien de {services} et le formulaire propose son adresse d’intégration et"
" les réglages nécessaires."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:33
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:19
#, python-brace-format
msgid "This site accepts pages from these hosts only: {hosts}."
msgstr "Ce site n’accepte que les pages de ces hôtes : {hosts}."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:38
msgid ""
"In Chrome and Edge, this PDF stays blank with this preset: they don't "
"show PDFs in a sandbox."
msgstr ""
"Dans Chrome et Edge, ce PDF reste vide avec ce profil : ils n’affichent "
"pas les PDF dans un bac à sable."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:40
msgid "Use a PDF (Plus) view instead."
msgstr "Utilisez plutôt une vue PDF (Plus)."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:42
msgid "If you trust the site the PDF comes from, the External preset shows it."
msgstr ""
"Si vous faites confiance au site d’où vient le PDF, le profil Externe "
"l’affiche."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:44
msgid ""
"Link to the PDF instead, or ask your site administrator about the PDF "
"(Plus) view."
msgstr ""
"Mettez plutôt un lien vers le PDF, ou demandez à l’administrateur du site"
" la vue PDF (Plus)."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:48
msgid ""
"This resource is a PDF: the PDF (Plus) view shows it better, on phones "
"too."
msgstr ""
"Cette ressource est un PDF : la vue PDF (Plus) l’affiche mieux, sur "
"téléphone aussi."

# | msgid "" "{service} only works with the {preset} preset, which this site
# | runs as " "Interactive until it serves uploads from a separate content
# | origin, so it" " won't play here yet."
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:52
#, python-brace-format
msgid ""
"{service} only works with the {preset} preset, which this site runs as "
"Interactive until it has a separate domain for uploads, so it won't play "
"here yet. Ask your site administrator."
msgstr ""
"{service} ne fonctionne qu’avec le profil {preset}, que ce site exécute "
"comme Interactif tant qu’il n’a pas de domaine distinct pour les fichiers"
" téléversés : il ne fonctionnera donc pas encore ici. Demandez à "
"l’administrateur du site."

# | msgid "" "{service} only works with the {preset} preset, which this site
# | runs as " "Interactive until it serves uploads from a separate content
# | origin, so it" " won't play here yet."
# | runs as " "Interactive until it has a separate domain for uploads, so it
# | won't play " "here yet. Ask your site administrator."
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:53
#, python-brace-format
msgid ""
"{service} only works with the {preset} preset, which this site runs as "
"Interactive while it doesn't sandbox downloads, so it won't play here. "
"Ask your site administrator."
msgstr ""
"{service} ne fonctionne qu’avec le profil {preset}, que ce site exécute "
"comme Interactif tant qu’il ne met pas les téléchargements en bac à sable"
" : il ne fonctionnera donc pas ici. Demandez à l’administrateur du site."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:54
#, python-brace-format
msgid ""
"{service} only works with the {preset} preset, which this site doesn't "
"allow."
msgstr ""
"{service} ne fonctionne qu’avec le profil {preset}, que ce site "
"n’autorise pas."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:55
#, python-brace-format
msgid ""
"{service} embeds come from {host}, which isn't on this site's list of "
"allowed hosts."
msgstr ""
"Les intégrations {service} proviennent de {host}, qui ne figure pas dans "
"la liste des hôtes autorisés de ce site."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:56
#, python-brace-format
msgid ""
"{service}'s viewer fetches the file from its own servers, so it can't "
"show a file in a private dataset."
msgstr ""
"La visionneuse de {service} récupère le fichier depuis ses propres "
"serveurs : elle ne peut donc pas afficher un fichier d'un jeu de données "
"privé."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:57
#, python-brace-format
msgid ""
"{service} doesn't let its pages show inside other sites, so this view "
"would stay blank. Use the page's embed or share address if it has one, or"
" link to it instead."
msgstr ""
"{service} ne permet pas d'afficher ses pages dans d'autres sites : cette "
"vue resterait vide. Utilisez l'adresse d'intégration ou de partage de la "
"page si elle en a une, ou mettez plutôt un lien vers elle."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:68
#, python-brace-format
msgid ""
"This is a {service} page. Use its embed address and the settings its "
"embed needs?"
msgstr ""
"Ceci est une page {service}. Utiliser son adresse d’intégration et les "
"réglages dont elle a besoin ?"

#. a button accepting the suggested embed address and settings.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:70
msgid "Use them"
msgstr "Les utiliser"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:71
#, python-brace-format
msgid ""
"Using the embed address and settings for {service}. Save the view to keep"
" them."
msgstr ""
"Adresse d’intégration et réglages de {service} appliqués. Enregistrez la "
"vue pour les conserver."

# | msgid "" "This site refuses to be embedded ({reason}), so the view will
# show
# | an " "error. Consider linking to it instead."
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:85
msgid ""
"This site refuses to be embedded, so the view will show an error. "
"Consider linking to it instead."
msgstr ""
"Ce site refuse d’être intégré : la vue affichera donc une erreur. "
"Envisagez plutôt d’y mettre un lien."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:86
msgid "Couldn't check whether this site allows embedding."
msgstr "Impossible de vérifier si ce site autorise l’intégration."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:90
msgid "Security preset"
msgstr "Profil de sécurité"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:99
msgid ""
"Choose the most restrictive preset that works: if the page stays blank or"
" broken, try the next one."
msgstr ""
"Choisissez le profil le plus restrictif qui fonctionne : si la page reste"
" vide ou cassée, essayez le suivant."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:100
msgid "External turns the sandbox off, so use it only for sites you trust."
msgstr ""
"Externe désactive la sandbox : ne l’utilisez que pour des sites de "
"confiance."

# | msgid "" "This preset needs uploaded HTML to be served from a separate
# | content " "origin, which this site doesn't have yet, so the view runs as "
# | "Interactive."
# | msgid "" "This preset needs a separate domain for uploads, which this site
# | doesn't " "have yet, so the view runs as Interactive. Ask your site
# | administrator if" " you need it."
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:108
msgid ""
"This upload is kept where the separate domain for uploads can't serve it "
"from, so the view runs as Interactive."
msgstr ""
"Ce fichier téléversé est stocké là où le domaine distinct pour les "
"fichiers téléversés ne peut pas le servir : la vue fonctionne donc comme "
"Interactif."

# | msgid "" "This preset needs uploaded HTML to be served from a separate
# | content " "origin, which this site doesn't have yet, so the view runs as "
# | "Interactive."
# | msgid "" "This preset needs a separate domain for uploads, which this site
# | doesn't " "have yet, so the view runs as Interactive. Ask your site
# | administrator if" " you need it."
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:110
msgid ""
"External needs this site to sandbox downloads, which it has turned off, "
"so the view runs as Interactive. Ask your site administrator if you need "
"it."
msgstr ""
"Externe nécessite que ce site mette les téléchargements en bac à sable, "
"ce qu’il a désactivé : la vue fonctionne donc comme Interactif. Demandez "
"à l’administrateur du site si vous en avez besoin."

# | msgid "" "This preset needs uploaded HTML to be served from a separate
# | content " "origin, which this site doesn't have yet, so the view runs as "
# | "Interactive."
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:112
msgid ""
"This preset needs a separate domain for uploads, which this site doesn't "
"have yet, so the view runs as Interactive. Ask your site administrator if"
" you need it."
msgstr ""
"Ce profil nécessite un domaine distinct pour les fichiers téléversés, ce "
"que ce site n’a pas encore : la vue fonctionne donc comme Interactif. "
"Demandez à l’administrateur du site si vous en avez besoin."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:114
msgid ""
"Charts, the Tour and Explore work. Maps work only in Data Schematics made"
" with qsv 29.0.0 or later."
msgstr ""
"Les graphiques, la visite guidée (Tour) et Explore fonctionnent. Les "
"cartes ne fonctionnent que dans les Data Schematics créés avec qsv 29.0.0"
" ou ultérieur."

# | msgid "" "This view's sandbox would let scripts keep a real origin, which
# | isn't " "allowed here, so it runs as Strict."
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:118
msgid ""
"These sandbox settings could let the page use visitors' logins on this "
"site, which isn't allowed, so the view runs as Strict."
msgstr ""
"Ces réglages du sandbox pourraient laisser la page utiliser les "
"connexions des visiteurs sur ce site, ce qui n’est pas autorisé : la vue "
"fonctionne donc comme Strict."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:121
msgid ""
"In Chrome and Edge, this site loads pages with this preset without the "
"visitor's cookies or saved data, so logins inside the page and sign-in "
"popups won't work."
msgstr ""
"Dans Chrome et Edge, ce site charge les pages de ce profil sans les "
"cookies ni les données enregistrées du visiteur : les connexions dans la "
"page et les fenêtres de connexion ne fonctionneront pas."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:125
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:24
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:18
msgid "Height"
msgstr "Hauteur"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:128
msgid "Preset's default"
msgstr "Celle du profil"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:134
msgid ""
"Auto fits pages that report their own height, such as qsv Data "
"Schematics. Other pages keep a fixed fallback height."
msgstr ""
"Automatique s’adapte aux pages qui indiquent leur propre hauteur, comme "
"les Data Schematics de qsv. Les autres pages gardent une hauteur fixe de "
"secours."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:138
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:35
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:29
msgid "Height value"
msgstr "Valeur de hauteur"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:138
msgid "eg. 600, 80 or 16/9"
msgstr "p. ex. 600, 80 ou 16/9"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:139
msgid ""
"Pixels for Fixed, a number from 1 to 100 for a share of the window, or a "
"ratio such as 16/9. Auto and the preset's default need no value."
msgstr ""
"Des pixels pour Fixe, un nombre de 1 à 100 pour une part de la fenêtre, "
"ou un rapport comme 16/9. Automatique et Celle du profil n’ont besoin "
"d’aucune valeur."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:144
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:41
msgid "Thumbnail in the resource list"
msgstr "Miniature dans la liste des ressources"

#. no thumbnail image chosen (the image, feminine in some languages).
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:148
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:45
#: ckanext/webpageviewplus/thumbnail_templates/webpageviewplus/manage_dataset.html:69
msgid "None"
msgstr "Aucune"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:155
msgid ""
"An image in this dataset (PNG, JPEG, WebP or GIF), uploaded or linked, "
"shown small beside this resource in the dataset's list. With None, the "
"page's own preview image, a well-known service's logo or the format icon "
"shows."
msgstr ""
"Une image de ce jeu de données (PNG, JPEG, WebP ou GIF), téléversée ou "
"liée, affichée en petit à côté de cette ressource dans la liste du jeu de"
" données. Avec Aucune, l'image d'aperçu de la page elle-même, le logo "
"d'un service connu ou l'icône du format s'affiche."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:157
msgid ""
"An image uploaded to this dataset (PNG, JPEG, WebP or GIF), shown small "
"beside this resource in the dataset's list. With None, a well-known "
"service's logo or the format icon shows."
msgstr ""
"Une image téléversée dans ce jeu de données (PNG, JPEG, WebP ou GIF), "
"affichée en petit à côté de cette ressource dans la liste du jeu de "
"données. Avec Aucune, le logo d'un service connu ou l'icône du format "
"s'affiche."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:164
msgid "Don't make a thumbnail automatically"
msgstr "Ne pas créer de miniature automatiquement"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:166
msgid ""
"Otherwise, when no image is chosen above, this site fetches the image the"
" page names for link previews, once when the view is saved, and shows a "
"small copy."
msgstr ""
"Sinon, lorsqu'aucune image n'est choisie ci-dessus, ce site récupère "
"l'image que la page indique pour les aperçus de liens, une fois à "
"l'enregistrement de la vue, et en affiche une petite copie."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:168
msgid ""
"Otherwise, when no image is chosen above, an Office file uploaded to this"
" dataset shows the preview picture saved inside it."
msgstr ""
"Sinon, quand aucune image n’est choisie ci-dessus, un fichier Office "
"téléversé dans ce jeu de données affiche l’image d’aperçu enregistrée à "
"l’intérieur."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:171
msgid ""
"It also stops screenshots of a page that refuses to be shown here, and "
"saving with it ticked deletes any screenshot already taken."
msgstr ""
"Elle empêche aussi les captures d'écran d'une page qui refuse d'être "
"affichée ici, et enregistrer avec la case cochée supprime toute capture "
"déjà prise."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:180
#: ckanext/webpageviewplus/thumbnail_templates/webpageviewplus/manage_dataset.html:18
msgid "the page didn't load"
msgstr "la page ne s'est pas chargée"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:181
#: ckanext/webpageviewplus/thumbnail_templates/webpageviewplus/manage_dataset.html:19
msgid "the page couldn't be reached"
msgstr "la page était injoignable"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:182
#: ckanext/webpageviewplus/thumbnail_templates/webpageviewplus/manage_dataset.html:20
msgid "the screenshot service refused the request"
msgstr "le service de capture a refusé la requête"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:183
#: ckanext/webpageviewplus/thumbnail_templates/webpageviewplus/manage_dataset.html:21
msgid "the screenshot service's allowance is used up for now"
msgstr "le quota du service de capture est épuisé pour l'instant"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:184
#: ckanext/webpageviewplus/thumbnail_templates/webpageviewplus/manage_dataset.html:22
msgid "the answer wasn't an image"
msgstr "la réponse n'était pas une image"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:185
#: ckanext/webpageviewplus/thumbnail_templates/webpageviewplus/manage_dataset.html:23
msgid "the screenshot service isn't set up safely"
msgstr "le service de capture n'est pas configuré de façon sûre"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:188
#: ckanext/webpageviewplus/thumbnail_templates/webpageviewplus/manage_dataset.html:38
#: ckanext/webpageviewplus/thumbnail_templates/webpageviewplus/manage_dataset.html:74
msgid "Screenshot"
msgstr "Capture d'écran"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:190
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:20
#, python-brace-format
msgid "Screenshot of {host}"
msgstr "Capture d’écran de {host}"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:194
#: ckanext/webpageviewplus/thumbnail_templates/webpageviewplus/manage_dataset.html:92
msgid ""
"A screenshot is taken after you save, if this page can't be shown in a "
"frame."
msgstr ""
"Une capture est prise après l'enregistrement, si cette page ne peut pas "
"être affichée dans un cadre."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:196
#, python-brace-format
msgid ""
"The screenshot is of {url}. A new one is taken after you save, if the new"
" page can't be shown in a frame."
msgstr ""
"La capture montre {url}. Une nouvelle est prise après l'enregistrement, "
"si la nouvelle page ne peut pas être affichée dans un cadre."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:198
#: ckanext/webpageviewplus/thumbnail_templates/webpageviewplus/manage_dataset.html:84
msgid "This page can now be shown in a frame, so the screenshot isn't used."
msgstr ""
"Cette page peut maintenant être affichée dans un cadre, la capture n'est "
"donc pas utilisée."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:200
#: ckanext/webpageviewplus/thumbnail_templates/webpageviewplus/manage_dataset.html:86
msgid "You picked a thumbnail, so the screenshot isn't used."
msgstr "Vous avez choisi une miniature, la capture n'est donc pas utilisée."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:202
#: ckanext/webpageviewplus/thumbnail_templates/webpageviewplus/manage_dataset.html:88
msgid "This dataset is private, so screenshots aren't taken."
msgstr "Ce jeu de données est privé, aucune capture n'est donc prise."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:204
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:218
msgid ""
"A screenshot will be taken in the background. Reload this form later to "
"see it."
msgstr ""
"Une capture sera prise en arrière-plan. Rechargez ce formulaire plus tard"
" pour la voir."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:204
msgid ""
"This site takes screenshots on a schedule. Reload this form later to see "
"it."
msgstr ""
"Ce site prend des captures selon un calendrier. Rechargez ce formulaire "
"plus tard pour la voir."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:206
#: ckanext/webpageviewplus/thumbnail_templates/webpageviewplus/manage_dataset.html:82
#, python-brace-format
msgid "The last attempt on {date} failed: {reason}."
msgstr "La dernière tentative, le {date}, a échoué : {reason}."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:208
#, python-brace-format
msgid "Taken {date}, of {host}."
msgstr "Prise le {date}, de {host}."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:208
#, python-brace-format
msgid "Taken {date}."
msgstr "Prise le {date}."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:209
msgid ""
"Shown on this view's card. The resource list shows the page's own "
"thumbnail instead."
msgstr ""
"Affichée sur la carte de cette vue. La liste des ressources affiche à la "
"place la miniature propre à la page."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:209
msgid "Shown on this view's card and as its thumbnail in the resource list."
msgstr ""
"Affichée sur la carte de cette vue et comme miniature dans la liste des "
"ressources."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:220
#: ckanext/webpageviewplus/thumbnail_templates/webpageviewplus/manage_dataset.html:104
msgid "Take a new screenshot"
msgstr "Prendre une nouvelle capture"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:232
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:71
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:36
msgid "Hide the control bar (Open in new tab, Fullscreen, Reload)"
msgstr ""
"Masquer la barre de commandes (Ouvrir dans un nouvel onglet, Plein écran,"
" Recharger)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:233
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:72
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:37
msgid ""
"On phones and at high zoom, Open in new tab still shows, so visitors can "
"always reach the page."
msgstr ""
"Sur téléphone et en fort zoom, Ouvrir dans un nouvel onglet reste "
"affiché, pour que les visiteurs puissent toujours atteindre la page."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:237
msgid "Ask before loading a page from another site"
msgstr "Demander avant de charger une page d’un autre site"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:238
msgid ""
"Visitors see a card naming the site, and nothing loads from it until they"
" choose Load. Uploads and pages on this site load as usual."
msgstr ""
"Les visiteurs voient une carte indiquant le site, et rien n’en est chargé"
" avant qu’ils choisissent Charger. Les fichiers téléversés et les pages "
"de ce site se chargent normalement."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:243
msgid "Count visits (daily totals only, nothing about visitors; the view says so)"
msgstr ""
"Compter les visites (totaux quotidiens uniquement, rien sur les visiteurs"
" ; la vue l’indique)"

#. view counts as "label: number" pairs, so no plural forms are needed.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:249
#, python-brace-format
msgid ""
"Last 30 days. Shown: {impressions}. Seen: {seen}. Loaded: {loaded}. Used:"
" {engaged}. Failed: {failed}."
msgstr ""
"30 derniers jours. Affichée : {impressions}. Vue à l’écran : {seen}. "
"Chargée : {loaded}. Utilisée : {engaged}. En échec : {failed}."

#. heading of the advanced (sysadmin-only) settings.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:258
msgid "Advanced"
msgstr "Avancé"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:259
msgid ""
"Each field replaces the preset's value; leave it blank to keep the "
"preset's. A sandbox with both allow-scripts and allow-same-origin is "
"refused wherever it could let a page act as this site."
msgstr ""
"Chaque champ remplace la valeur du profil ; laissez-le vide pour garder "
"celle du profil. Une sandbox combinant allow-scripts et allow-same-origin"
" est refusée partout où elle pourrait laisser une page agir comme ce "
"site."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:260
msgid "Sandbox tokens (replace the preset's)"
msgstr "Jetons de sandbox (remplacent ceux du profil)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:260
msgid "eg. allow-scripts allow-popups"
msgstr "p. ex. allow-scripts allow-popups"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:261
msgid "Allowed features (replace the preset's)"
msgstr "Fonctionnalités autorisées (remplacent celles du profil)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:261
msgid "eg. fullscreen; clipboard-write"
msgstr "p. ex. fullscreen; clipboard-write"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:263
msgid "Referrer policy"
msgstr "Politique de référent"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:266
msgid "Site default"
msgstr "Celle du site"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:12
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:155
msgid ""
"This PDF can't be shown: the site needs a separate domain for uploaded "
"content."
msgstr ""
"Ce PDF ne peut pas être affiché : le site a besoin d’un domaine distinct "
"pour le contenu téléversé."

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:15
msgid "PDF url"
msgstr "URL du PDF"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:15
msgid "eg. https://example.com/report.pdf  (if blank uses resource url)"
msgstr ""
"ex. https://example.com/report.pdf  (si vide, l’URL de la ressource est "
"utilisée)"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:17
msgid ""
"Leave blank to show this resource's own file. A PDF on another site is "
"fetched by this site and shown from here, so visitors never contact that "
"site."
msgstr ""
"Laissez vide pour afficher le fichier de cette ressource. Un PDF situé "
"sur un autre site est récupéré par ce site et affiché d’ici, si bien que "
"les visiteurs ne contactent jamais cet autre site."

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:18
#, python-brace-format
msgid "Files on other sites are shown up to {size} MB."
msgstr "Les fichiers d’autres sites sont affichés jusqu’à {size} Mo."

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:35
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:29
msgid "eg. 800 or 80"
msgstr "ex. 800 ou 80"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:36
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:30
msgid ""
"Pixels for Fixed, or a number from 1 to 100 for a share of the window. "
"Blank is 800 pixels."
msgstr ""
"Des pixels pour Fixe, ou un nombre de 1 à 100 pour une part de la "
"fenêtre. Vide : 800 pixels."

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:46
#: ckanext/webpageviewplus/thumbnail_templates/webpageviewplus/manage_dataset.html:14
msgid "The PDF's first page"
msgstr "La première page du PDF"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:52
msgid ""
"An image in this dataset (PNG, JPEG, WebP or GIF), shown small beside "
"this resource in the dataset's list. With None, the format icon shows."
msgstr ""
"Une image de ce jeu de données (PNG, JPEG, WebP ou GIF), affichée en "
"petit à côté de cette ressource dans la liste du jeu de données. Avec "
"Aucune, l’icône du format s’affiche."

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:53
msgid ""
"The PDF's first page is drawn in your browser when you choose it, and "
"again when you edit the view after an uploaded file has changed, or every"
" time for a PDF linked from another site."
msgstr ""
"La première page du PDF est dessinée dans votre navigateur quand vous la "
"choisissez, et de nouveau quand vous modifiez la vue après un changement "
"du fichier téléversé, ou à chaque fois pour un PDF lié depuis un autre "
"site."

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:60
msgid "Drawing the first page…"
msgstr "Dessin de la première page…"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:61
msgid "The first page is ready. Save the view to use it."
msgstr "La première page est prête. Enregistrez la vue pour l’utiliser."

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:62
msgid ""
"Couldn't draw the first page. Check the PDF shows in the view, then try "
"again."
msgstr ""
"Impossible de dessiner la première page. Vérifiez que le PDF s’affiche "
"dans la vue, puis réessayez."

# | msgid "Save the view first, then choose the first page again."
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:63
msgid "Save the view, then edit it again to draw the first page."
msgstr ""
"Enregistrez la vue, puis modifiez-la de nouveau pour dessiner la première"
" page."

#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:11
msgid "Repository url"
msgstr "URL du dépôt"

# | msgid "eg. https://github.com/ckan/ckan  (if blank uses resource url)"
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:11
msgid ""
"eg. https://github.com/ckan/ckan or https://gitlab.com/gitlab-org/gitlab"
"  (if blank uses resource url)"
msgstr ""
"p. ex. https://github.com/ckan/ckan ou https://gitlab.com/gitlab-"
"org/gitlab  (si vide, l’URL de la ressource est utilisée)"

# | msgid "" "Leave blank to show the repository this resource links to, or
# | enter " "another repository or branch to show instead. A public GitHub "
# | "repository's name, description, files and README are fetched by this
# site"
# | " and shown here, as GitHub's pages can't be embedded. Add /tree/<branch>
# "
# | "for a branch other than the default."
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:13
msgid ""
"Leave blank to show the repository this resource links to, or enter "
"another repository or branch to show instead. A public repository's name,"
" description, files and README are fetched by this site and shown here, "
"as the pages of GitHub, GitLab, Codeberg and Bitbucket can't be embedded."
" For a branch other than the default, use the address of the branch's "
"page."
msgstr ""
"Laissez vide pour afficher le dépôt vers lequel pointe cette ressource, "
"ou saisissez un autre dépôt ou une autre branche à afficher à la place. "
"Le nom, la description, les fichiers et le README d'un dépôt public sont "
"récupérés par ce site et affichés ici, car les pages de GitHub, GitLab, "
"Codeberg et Bitbucket ne peuvent pas être intégrées. Pour une autre "
"branche que celle par défaut, utilisez l'adresse de la page de la "
"branche."

#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:16
msgid "Archived"
msgstr "Archivé"

#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:18
#, python-brace-format
msgid "{count} star"
msgid_plural "{count} stars"
msgstr[0] "{count} étoile"
msgstr[1] "{count} étoiles"

#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:19
#, python-brace-format
msgid "{count} fork"
msgid_plural "{count} forks"
msgstr[0] "{count} fork"
msgstr[1] "{count} forks"

#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:20
#, python-brace-format
msgid "Updated {date}"
msgstr "Mis à jour le {date}"

#. the branch whose files are listed, such as "main".
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:22
#, python-brace-format
msgid "Branch: {ref}"
msgstr "Branche : {ref}"

#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:24
msgid "Files"
msgstr "Fichiers"

#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:29
#, python-brace-format
msgid "More files on {site}"
msgstr "Plus de fichiers sur {site}"

# | msgid "" "This site has used up its requests to GitHub for now, so the
# | repository " "can't be shown here. Try again later."
#. {site} is a code hosting site, such as GitHub or GitLab.
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:40
#, python-brace-format
msgid ""
"This site has used up its requests to {site} for now, so the repository "
