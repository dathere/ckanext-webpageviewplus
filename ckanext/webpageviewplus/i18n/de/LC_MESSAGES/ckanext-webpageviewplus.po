msgstr "Entfernt"

# | msgid "The thumbnail couldn't be remade, so the last one is kept."
#: ckanext/webpageviewplus/manage.py:687
msgid "Couldn't be remade, the last one kept"
msgstr "Nicht neu erstellt, das bisherige bleibt"

# | msgid "Pending."
#: ckanext/webpageviewplus/manage.py:688
msgid "Already pending"
msgstr "Bereits ausstehend"

#: ckanext/webpageviewplus/manage.py:689
msgid "Waiting for the cooldown"
msgstr "Wartezeit läuft noch"

