#: ckanext/webpageviewplus/actions.py:156
msgid "Must be a whole number"
msgstr "Muss eine ganze Zahl sein"

#: ckanext/webpageviewplus/plugin.py:138
msgid "Website (Plus)"
msgstr "Website (Plus)"

#: ckanext/webpageviewplus/plugin.py:157
msgid "Website"
msgstr "Website"

#: ckanext/webpageviewplus/plugin.py:253
msgid "Embedded web page"
msgstr "Eingebettete Webseite"

#: ckanext/webpageviewplus/validators.py:19
msgid "Web Page url must be an http:// or https:// URL"
msgstr "Die URL der Webseite muss eine http://- oder https://-URL sein"

#: ckanext/webpageviewplus/validators.py:28
msgid "Preset is not one of the allowed presets"
msgstr "Das Profil gehört nicht zu den erlaubten Profilen"

#: ckanext/webpageviewplus/validators.py:34
msgid "Unknown height mode"
msgstr "Unbekannter Höhenmodus"

#: ckanext/webpageviewplus/validators.py:47
#, python-brace-format
msgid "Unknown sandbox token: {tokens}"
msgid_plural "Unknown sandbox tokens: {tokens}"
msgstr[0] "Unbekanntes Sandbox-Token: {tokens}"
msgstr[1] "Unbekannte Sandbox-Tokens: {tokens}"

#: ckanext/webpageviewplus/validators.py:62
#, python-brace-format
msgid "This feature can't be granted: {features}"
msgid_plural "These features can't be granted: {features}"
msgstr[0] "Diese Funktion kann nicht gewährt werden: {features}"
msgstr[1] "Diese Funktionen können nicht gewährt werden: {features}"

#: ckanext/webpageviewplus/validators.py:70
msgid "Unknown referrer policy"
msgstr "Unbekannte Referrer-Richtlinie"

#: ckanext/webpageviewplus/validators.py:131
msgid "Height value doesn't fit the height mode"
msgstr "Der Höhenwert passt nicht zum Höhenmodus"

#: ckanext/webpageviewplus/validators.py:158
msgid ""
"External is for third-party sites: uploaded HTML always gets a sandbox. "
"Use Data Schematic or Interactive"
msgstr ""
"Extern ist für Websites Dritter gedacht: Hochgeladenes HTML erhält immer "
"eine Sandbox. Verwenden Sie Data Schematic oder Interaktiv"

#: ckanext/webpageviewplus/validators.py:171
msgid "This host isn't on the site's list of allowed hosts"
msgstr "Dieser Host steht nicht auf der Liste der erlaubten Hosts der Website"

#: ckanext/webpageviewplus/validators.py:184
msgid ""
"This frame can't let scripts keep a real origin: don't combine allow-"
"scripts with allow-same-origin. Pages on this site never may; other pages"
" may once uploaded HTML is served from a separate content origin"
msgstr ""
"Dieser Frame darf Skripten keinen echten Ursprung lassen: Kombinieren Sie"
" allow-scripts nicht mit allow-same-origin. Seiten dieser Website dürfen "
"das nie; andere Seiten dürfen es, sobald hochgeladenes HTML von einem "
"separaten Content-Ursprung ausgeliefert wird"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:4
msgid "Strict: static HTML, no scripts"
msgstr "Streng: statisches HTML, keine Skripte"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:5
msgid "Interactive: scripts, forms, popups and downloads, no storage"
msgstr "Interaktiv: Skripte, Formulare, Pop-ups und Downloads, kein Speicher"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:6
msgid "External: a trusted third-party site, no sandbox"
msgstr "Extern: eine vertrauenswürdige Website Dritter, keine Sandbox"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:7
msgid ""
"External: a trusted third-party site, no sandbox (runs as Interactive for"
" now)"
msgstr ""
"Extern: eine vertrauenswürdige Website Dritter, keine Sandbox (läuft "
"vorerst als Interaktiv)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:8
msgid "Data Schematic: qsv Data Schematics"
msgstr "Data Schematic: qsv Data Schematics"

#. how the embedded page's height is set; "Auto" means the page reports its own
#. height.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:12
msgid "Auto"
msgstr "Automatisch"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:13
msgid "Fixed (px)"
msgstr "Fest (px)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:14
msgid "Share of the window height, in percent"
msgstr "Anteil der Fensterhöhe, in Prozent"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:15
msgid "Aspect ratio (e.g. 16/9)"
msgstr "Seitenverhältnis (z. B. 16/9)"

#. names of security presets, as in "the External preset".
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:20
msgid "Strict"
msgstr "Streng"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:21
msgid "Interactive"
msgstr "Interaktiv"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:22
msgid "External"
msgstr "Extern"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:23
msgid "Data Schematic"
msgstr "Data Schematic"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:27
msgid "Web Page url"
msgstr "URL der Webseite"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:27
msgid "eg. http://example.com  (if blank uses resource url)"
msgstr ""
"z. B. http://example.com  (wenn leer, wird die URL der Ressource "
"verwendet)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:29
msgid ""
"Leave blank to show this resource's own address. Paste a link from a "
"well-known service, such as YouTube, Datawrapper, Power BI or CARTO, and "
"the form suggests its embed address and settings."
msgstr ""
"Leer lassen, um die eigene Adresse dieser Ressource anzuzeigen. Fügen Sie"
" einen Link von einem bekannten Dienst wie YouTube, Datawrapper, Power BI"
" oder CARTO ein, und das Formular schlägt die Einbettungsadresse und die "
"passenden Einstellungen vor."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:30
msgid "This site accepts pages from these hosts only: {hosts}."
msgstr "Diese Website akzeptiert nur Seiten von diesen Hosts: {hosts}."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:40
#, python-brace-format
msgid ""
"This is a {service} page. Use its embed address and the settings its "
"embed needs?"
msgstr ""
"Dies ist eine {service}-Seite. Ihre Einbettungsadresse und die "
"Einstellungen verwenden, die die Einbettung braucht?"

#. a button accepting the suggested embed address and settings.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:42
msgid "Use them"
msgstr "Verwenden"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:43
#, python-brace-format
msgid ""
"Using the embed address and settings for {service}. Save the view to keep"
" them."
msgstr ""
"Einbettungsadresse und Einstellungen für {service} werden verwendet. "
"Speichern Sie die Ansicht, um sie zu behalten."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:44
#, python-brace-format
msgid ""
"{service} only works with the {preset} preset, which this site runs as "
"Interactive until it serves uploads from a separate content origin, so it"
" won't play here yet."
msgstr ""
"{service} funktioniert nur mit dem Profil {preset}, das diese Website als"
" Interaktiv ausführt, bis sie Uploads von einem separaten Content-"
"Ursprung ausliefert. Hier wird es deshalb noch nicht abgespielt."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:45
#, python-brace-format
msgid ""
"{service} only works with the {preset} preset, which this site doesn't "
"allow."
msgstr ""
"{service} funktioniert nur mit dem Profil {preset}, das diese Website "
"nicht erlaubt."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:46
#, python-brace-format
msgid ""
"{service} embeds come from {host}, which isn't on this site's list of "
"allowed hosts."
msgstr ""
"Einbettungen von {service} kommen von {host}, der nicht auf der Liste der"
" erlaubten Hosts dieser Website steht."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:52
#, python-brace-format
msgid ""
"This site refuses to be embedded ({reason}), so the view will show an "
"error. Consider linking to it instead."
msgstr ""
"Diese Website lässt sich nicht einbetten ({reason}), daher zeigt die "
"Ansicht einen Fehler. Verlinken Sie sie besser."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:53
msgid "Couldn't check whether this site allows embedding."
msgstr "Es konnte nicht geprüft werden, ob diese Website das Einbetten erlaubt."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:57
msgid "Security preset"
msgstr "Sicherheitsprofil"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:66
msgid ""
"Choose the most restrictive preset that works: if the page stays blank or"
" broken, try the next one."
msgstr ""
"Wählen Sie das restriktivste Profil, das funktioniert: Bleibt die Seite "
"leer oder fehlerhaft, versuchen Sie das nächste."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:67
msgid "External turns the sandbox off, so use it only for sites you trust."
msgstr ""
"Extern schaltet die Sandbox ab, verwenden Sie es also nur für "
"vertrauenswürdige Websites."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:74
msgid ""
"This preset needs uploaded HTML to be served from a separate content "
"origin, which this site doesn't have yet, so the view runs as "
"Interactive."
msgstr ""
"Dieses Profil braucht einen separaten Content-Ursprung für hochgeladenes "
"HTML, den diese Website noch nicht hat, daher läuft die Ansicht als "
"Interaktiv."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:75
msgid "Charts, the Tour and Explore work, but maps stay blank."
msgstr "Diagramme, die Tour und Explore funktionieren, aber Karten bleiben leer."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:79
msgid ""
"This view's sandbox would let scripts keep a real origin, which isn't "
"allowed here, so it runs as Strict."
msgstr ""
"Die Sandbox dieser Ansicht würde Skripten einen echten Ursprung lassen, "
"was hier nicht erlaubt ist, daher läuft sie als Streng."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:82
msgid ""
"In Chrome and Edge, this site loads pages with this preset without the "
"visitor's cookies or saved data, so logins inside the page and sign-in "
"popups won't work."
msgstr ""
"In Chrome und Edge lädt diese Website Seiten mit diesem Profil ohne die "
"Cookies und gespeicherten Daten der Besucher, daher funktionieren "
"Anmeldungen innerhalb der Seite und Anmelde-Pop-ups nicht."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:86
msgid "Height"
msgstr "Höhe"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:89
msgid "Preset's default"
msgstr "Wie im Profil"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:95
msgid ""
"Auto fits pages that report their own height, such as qsv Data "
"Schematics. Other pages keep a fixed fallback height."
msgstr ""
"Automatisch passt sich Seiten an, die ihre eigene Höhe melden, etwa qsv "
"Data Schematics. Andere Seiten behalten eine feste Ersatzhöhe."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:99
msgid "Height value"
msgstr "Höhenwert"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:99
msgid "eg. 600, 80 or 16/9"
msgstr "z. B. 600, 80 oder 16/9"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:100
msgid ""
"Pixels for Fixed, a number from 1 to 100 for a share of the window, or a "
"ratio such as 16/9. Auto and the preset's default need no value."
msgstr ""
"Pixel für Fest, eine Zahl von 1 bis 100 für einen Anteil am Fenster oder "
"ein Verhältnis wie 16/9. Automatisch und Wie im Profil brauchen keinen "
"Wert."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:106
msgid "Hide the control bar (Open in new tab, Fullscreen, Reload)"
msgstr "Steuerleiste ausblenden (In neuem Tab öffnen, Vollbild, Neu laden)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:107
msgid ""
"On phones and at high zoom, Open in new tab still shows, so visitors can "
"always reach the page."
msgstr ""
"Auf Smartphones und bei starker Vergrößerung bleibt In neuem Tab öffnen "
"sichtbar, damit Besucher die Seite immer erreichen."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:111
msgid "Ask before loading a page from another site"
msgstr "Vor dem Laden einer Seite von einer anderen Website fragen"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:112
msgid ""
"Visitors see a card naming the site, and nothing loads from it until they"
" choose Load. Uploads and pages on this site load as usual."
msgstr ""
"Besucher sehen eine Karte mit dem Namen der Website, und nichts wird von "
"dort geladen, bis sie Laden wählen. Uploads und Seiten dieser Website "
"laden wie gewohnt."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:117
msgid "Count visits (daily totals only, nothing about visitors; the view says so)"
msgstr ""
"Besuche zählen (nur Tagessummen, nichts über Besucher; die Ansicht weist "
"darauf hin)"

#. view counts as "label: number" pairs, so no plural forms are needed.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:123
#, python-brace-format
msgid ""
"Last 30 days. Shown: {impressions}. Seen: {seen}. Loaded: {loaded}. Used:"
" {engaged}. Failed: {failed}."
msgstr ""
"Letzte 30 Tage. Angezeigt: {impressions}. Gesehen: {seen}. Geladen: "
"{loaded}. Genutzt: {engaged}. Fehlgeschlagen: {failed}."

#. heading of the advanced (sysadmin-only) settings.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:132
msgid "Advanced"
msgstr "Erweitert"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:133
msgid ""
"Each field replaces the preset's value; leave it blank to keep the "
"preset's. A sandbox with both allow-scripts and allow-same-origin is "
"refused wherever it could let a page act as this site."
msgstr ""
"Jedes Feld ersetzt den Wert des Profils; leer lassen, um den Wert des "
"Profils zu behalten. Eine Sandbox mit allow-scripts und allow-same-origin"
" zugleich wird überall abgelehnt, wo sie eine Seite als diese Website "
"handeln lassen könnte."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:134
msgid "Sandbox tokens (replace the preset's)"
msgstr "Sandbox-Tokens (ersetzen die des Profils)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:134
msgid "eg. allow-scripts allow-popups"
msgstr "z. B. allow-scripts allow-popups"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:135
msgid "Allowed features (replace the preset's)"
msgstr "Erlaubte Funktionen (ersetzen die des Profils)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:135
msgid "eg. fullscreen; clipboard-write"
msgstr "z. B. fullscreen; clipboard-write"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:137
msgid "Referrer policy"
msgstr "Referrer-Richtlinie"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:140
msgid "Site default"
msgstr "Wie auf der Website"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:8
msgid ""
"This page can't be shown here: it's served over http://, which browsers "
"block inside https:// sites."
msgstr ""
"Diese Seite kann hier nicht angezeigt werden: Sie wird über http:// "
"ausgeliefert, was Browser innerhalb von https://-Websites blockieren."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:10
#, python-brace-format
msgid "{host} doesn't allow its pages to be shown inside other sites."
msgstr ""
"{host} erlaubt nicht, dass seine Seiten innerhalb anderer Websites "
"angezeigt werden."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:13
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:110
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:136
msgid "Open in new tab"
msgstr "In neuem Tab öffnen"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:24
msgid "Skip embedded content"
msgstr "Eingebettete Inhalte überspringen"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:29
#, python-brace-format
msgid "Interact with {title}"
msgstr "Mit {title} interagieren"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:29
msgid "Tap to interact"
msgstr "Zum Interagieren tippen"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:55
#, python-brace-format
msgid "This view loads content from {host}."
msgstr "Diese Ansicht lädt Inhalte von {host}."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:57
msgid ""
"Loading it lets {host} see that you are viewing this page, and it may "
"recognise you if you are signed in there."
msgstr ""
"Beim Laden erfährt {host}, dass Sie diese Seite ansehen, und erkennt Sie "
"womöglich, wenn Sie dort angemeldet sind."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:58
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:103
msgid "Privacy policy"
msgstr "Datenschutzerklärung"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:61
msgid "Not loaded, to save data."
msgstr "Nicht geladen, um Daten zu sparen."

#. a button loading the embedded page; {size} is its file size, e.g. "1.2 MB".
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:65
#, python-brace-format
msgid "Load ({size})"
msgstr "Laden ({size})"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:65
msgid "Load"
msgstr "Laden"

#. a button that loads the page and remembers, in this browser, to load pages
#. from
#. {host} without asking.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:70
#, python-brace-format
msgid "Always load from {host}"
msgstr "Immer von {host} laden"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:77
msgid "Content from {host} loads without asking in this browser."
msgstr "Inhalte von {host} werden in diesem Browser ohne Nachfrage geladen."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:79
msgid "You will be asked again next time."
msgstr "Sie werden beim nächsten Mal wieder gefragt."

#. a button that forgets the choice to always load pages from a site.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:81
msgid "Ask me again"
msgstr "Wieder fragen"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:93
#, python-brace-format
msgid "{title} loaded"
msgstr "{title} geladen"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:96
msgid "This page connects to"
msgstr "Diese Seite verbindet sich mit"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:102
msgid "This view counts visits."
msgstr "Diese Ansicht zählt Besuche."

#. accessible name of the toolbar under an embedded web page.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:108
msgid "Embedded page"
msgstr "Eingebettete Seite"

#. "Expand" makes the embedded page fill the window; "Fullscreen" fills the
#. screen.
#. Buttons.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:117
msgid "Expand"
msgstr "Vergrößern"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:117
msgid "Fullscreen"
msgstr "Vollbild"

#. a button leaving the expanded (full-window) view.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:119
msgid "Close"
msgstr "Schließen"

#. a button reloading the embedded page.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:123
msgid "Reload"
msgstr "Neu laden"

#. a button opening the device's share sheet for this page.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:129
msgid "Share"
msgstr "Teilen"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:140
msgid ""
"This page can't be embedded: its host isn't on this site's list of "
"allowed hosts."
msgstr ""
"Diese Seite kann nicht eingebettet werden: Ihr Host steht nicht auf der "
"Liste der erlaubten Hosts dieser Website."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:142
msgid ""
"This page cannot be embedded: only http:// and https:// URLs are "
"supported."
msgstr ""
"Diese Seite kann nicht eingebettet werden: Nur http://- und https://-URLs"
" werden unterstützt."

