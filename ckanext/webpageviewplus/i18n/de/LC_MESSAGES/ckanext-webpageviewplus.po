msgstr "Höchstens {count} Ansichten auf einmal."

#: ckanext/webpageviewplus/manage.py:454
#, python-brace-format
msgid ""
"No worker reads the {queue} queue, so remakes can't be queued. Remake one"
" view at a time, or run ckan webpageviewplus check-views."
msgstr ""
"Kein Worker liest die Warteschlange {queue}, daher können keine "
"Neuerstellungen eingereiht werden. Erstellen Sie die Ansichten einzeln "
"neu oder führen Sie ckan webpageviewplus check-views aus."

#: ckanext/webpageviewplus/manage.py:488
msgid "Unknown value."
msgstr "Unbekannter Wert."

# | msgid "PDF view not found"
#: ckanext/webpageviewplus/manage.py:521 ckanext/webpageviewplus/manage.py:527
