msgstr[0] "Sie können in {seconds} Sekunde ein neues Bildschirmfoto aufnehmen."
msgstr[1] "Sie können in {seconds} Sekunden ein neues Bildschirmfoto aufnehmen."

# | msgid "Must be a whole number"
