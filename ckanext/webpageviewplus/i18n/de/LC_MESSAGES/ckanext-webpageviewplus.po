msgstr "Datensatz nicht gefunden"

#: ckanext/webpageviewplus/manage.py:523 ckanext/webpageviewplus/manage.py:582
msgid "Not authorized to see this page"
msgstr "Keine Berechtigung für diese Seite"

# | msgid "PDF view not found"
#: ckanext/webpageviewplus/manage.py:564
msgid "View not found"
msgstr "Ansicht nicht gefunden"

# | msgid "" "A screenshot will be taken in the background. Reload this form
# | later to " "see it."
#: ckanext/webpageviewplus/manage.py:598
msgid ""
"A screenshot will be taken in the background. Reload this page later to "
"see it."
msgstr ""
"Ein Bildschirmfoto wird im Hintergrund aufgenommen. Laden Sie diese Seite"
" später neu, um es zu sehen."

#: ckanext/webpageviewplus/manage.py:614
msgid "The thumbnail was remade."
msgstr "Das Vorschaubild wurde neu erstellt."

#: ckanext/webpageviewplus/manage.py:615
msgid "The thumbnail couldn't be remade, so the last one is kept."
msgstr ""
"Das Vorschaubild konnte nicht neu erstellt werden, daher bleibt das "
"bisherige."

#: ckanext/webpageviewplus/manage.py:616
msgid "There's nothing to make a thumbnail from."
msgstr "Es gibt nichts, woraus ein Vorschaubild erstellt werden könnte."

# | msgid "The first page is ready. Save the view to use it."
#: ckanext/webpageviewplus/manage.py:617
msgid "Draw the first page again in the view's form."
msgstr "Zeichnen Sie die erste Seite im Formular der Ansicht erneut."

# | msgid "The repository couldn't be loaded. Try again later."
#: ckanext/webpageviewplus/manage.py:618
msgid "The thumbnail couldn't be remade. Try again later."
msgstr ""
"Das Vorschaubild konnte nicht neu erstellt werden. Versuchen Sie es "
"später erneut."

#: ckanext/webpageviewplus/manage.py:623
msgid ""
"Removed. Unless automatic thumbnails are off, a new one is made at the "
"next save or refresh."
msgstr ""
"Entfernt. Sofern automatische Vorschaubilder nicht ausgeschaltet sind, "
"wird beim nächsten Speichern oder Aktualisieren ein neues erstellt."

#: ckanext/webpageviewplus/manage.py:625
msgid "There was nothing to remove."
msgstr "Es gab nichts zu entfernen."

#: ckanext/webpageviewplus/manage.py:631
msgid "Pick one of this dataset's images."
msgstr "Wählen Sie eines der Bilder dieses Datensatzes."

#: ckanext/webpageviewplus/manage.py:633
msgid "The thumbnail choice is saved."
msgstr "Die Auswahl des Vorschaubilds ist gespeichert."

#: ckanext/webpageviewplus/manage.py:638
msgid "Automatic thumbnails are off for this view."
msgstr "Automatische Vorschaubilder sind für diese Ansicht ausgeschaltet."

# | msgid "Thumbnails aren't enabled on this site"
#: ckanext/webpageviewplus/manage.py:639
msgid "Automatic thumbnails are on for this view."
msgstr "Automatische Vorschaubilder sind für diese Ansicht eingeschaltet."

#: ckanext/webpageviewplus/manage.py:640 ckanext/webpageviewplus/manage.py:716
#: ckanext/webpageviewplus/manage.py:745
msgid "Unknown action."
msgstr "Unbekannte Aktion."

#: ckanext/webpageviewplus/manage.py:653
msgid "Need to be system administrator to administer"
msgstr "Sie müssen Systemadministrator sein, um dies zu verwalten"

#. TRANSLATORS: outcome labels in "label: number" pairs, so no plural forms are
#. needed.
#: ckanext/webpageviewplus/manage.py:684
msgid "Queued"
msgstr "Eingereiht"

