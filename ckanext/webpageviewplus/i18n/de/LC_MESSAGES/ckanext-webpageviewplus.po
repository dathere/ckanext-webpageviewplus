msgstr "PDF-Ansicht nicht gefunden"

#: ckanext/webpageviewplus/actions.py:332
msgid "Thumbnails aren't enabled on this site"
msgstr "Vorschaubilder sind auf dieser Website nicht aktiviert"

#: ckanext/webpageviewplus/actions.py:342
#: ckanext/webpageviewplus/actions.py:345
msgid "Not a usable image"
msgstr "Kein verwendbares Bild"

#: ckanext/webpageviewplus/plugin.py:158
msgid "Website (Plus)"
msgstr "Website (Plus)"

#: ckanext/webpageviewplus/plugin.py:317
msgid "Embedded web page"
msgstr "Eingebettete Webseite"

#: ckanext/webpageviewplus/plugin.py:530
msgid "PDF (Plus)"
msgstr "PDF (Plus)"

#: ckanext/webpageviewplus/plugin.py:543
msgid "PDF"
msgstr "PDF"

#: ckanext/webpageviewplus/plugin.py:600
msgid "PDF document"
msgstr "PDF-Dokument"

#: ckanext/webpageviewplus/plugin.py:708
msgid "Repository (Plus)"
msgstr "Repository (Plus)"

#: ckanext/webpageviewplus/plugin.py:719 ckanext/webpageviewplus/plugin.py:756
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:6
msgid "Repository"
msgstr "Repository"

#: ckanext/webpageviewplus/validators.py:19
msgid "Web Page url must be an http:// or https:// URL"
msgstr "Die URL der Webseite muss eine http://- oder https://-URL sein"

#: ckanext/webpageviewplus/validators.py:28
msgid "Preset is not one of the allowed presets"
msgstr "Das Profil gehört nicht zu den erlaubten Profilen"

#: ckanext/webpageviewplus/validators.py:34
#: ckanext/webpageviewplus/validators.py:282
msgid "Unknown height mode"
msgstr "Unbekannter Höhenmodus"

#: ckanext/webpageviewplus/validators.py:47
#, python-brace-format
msgid "Unknown sandbox token: {tokens}"
msgid_plural "Unknown sandbox tokens: {tokens}"
msgstr[0] "Unbekanntes Sandbox-Token: {tokens}"
msgstr[1] "Unbekannte Sandbox-Tokens: {tokens}"

#: ckanext/webpageviewplus/validators.py:62
#, python-brace-format
msgid "This feature can't be granted: {features}"
msgid_plural "These features can't be granted: {features}"
msgstr[0] "Diese Funktion kann nicht gewährt werden: {features}"
msgstr[1] "Diese Funktionen können nicht gewährt werden: {features}"

#: ckanext/webpageviewplus/validators.py:70
msgid "Unknown referrer policy"
msgstr "Unbekannte Referrer-Richtlinie"

#: ckanext/webpageviewplus/validators.py:131
msgid "A share of the window takes a number from 1 to 100"
msgstr "Ein Anteil am Fenster braucht eine Zahl von 1 bis 100"

#: ckanext/webpageviewplus/validators.py:133
msgid "An aspect ratio takes width/height, such as 16/9"
msgstr "Ein Seitenverhältnis braucht Breite/Höhe, etwa 16/9"

#: ckanext/webpageviewplus/validators.py:134
msgid "Fixed takes a number of pixels, such as 600"
msgstr "Fest braucht eine Anzahl Pixel, etwa 600"

#: ckanext/webpageviewplus/validators.py:179
msgid ""
"This page uses http://, which browsers block inside this https:// site. "
"Use its https:// address, or link to it instead"
msgstr ""
"Diese Seite verwendet http://, was Browser innerhalb dieser "
"https://-Website blockieren. Verwenden Sie ihre https://-Adresse oder "
"verlinken Sie sie stattdessen"

# | msgid "" "{service}'s viewer fetches the file from its own servers, so it
# | can't " "show a file in a private dataset."
#: ckanext/webpageviewplus/validators.py:198
msgid ""
"Microsoft's viewer fetches the file from its own servers, so it can't "
"show a file in a private dataset"
msgstr ""
"Der Viewer von Microsoft lädt die Datei von seinen eigenen Servern, daher"
" kann er keine Datei aus einem privaten Datensatz anzeigen"

#: ckanext/webpageviewplus/validators.py:219
msgid ""
"External is for third-party sites: uploaded HTML always gets a sandbox. "
"Use Data Schematic or Interactive"
msgstr ""
"Extern ist für Websites Dritter gedacht: Hochgeladenes HTML erhält immer "
"eine Sandbox. Verwenden Sie Data Schematic oder Interaktiv"

#: ckanext/webpageviewplus/validators.py:232
#: ckanext/webpageviewplus/validators.py:312
msgid "This host isn't on the site's list of allowed hosts"
msgstr "Dieser Host steht nicht auf der Liste der erlaubten Hosts der Website"

# | msgid "" "This frame can't let scripts keep a real origin: don't combine
# | allow-" "scripts with allow-same-origin. Pages on this site never may;
# other
# | pages" " may once uploaded HTML is served from a separate content origin"
# | msgid "" "These settings could let the page use visitors' logins on this
# | site: " "don't combine allow-scripts with allow-same-origin. Pages on this
# | site " "never may; other pages may once the site has a separate domain for
# "
# | "uploads"
#: ckanext/webpageviewplus/validators.py:246
msgid ""
"These settings could let the page use visitors' logins on this site: "
"don't combine allow-scripts with allow-same-origin. Pages on this site "
"and uploads never may; other pages may once the site sandboxes downloads "
"(harden_downloads)"
msgstr ""
"Diese Einstellungen könnten der Seite erlauben, die Anmeldungen der "
"Besucher auf dieser Website zu nutzen: Kombinieren Sie allow-scripts "
"nicht mit allow-same-origin. Seiten dieser Website und Uploads dürfen das"
" nie; andere Seiten erst, wenn die Website Downloads in einer Sandbox "
"ausliefert (harden_downloads)"

#: ckanext/webpageviewplus/validators.py:275
msgid "Choose an image from this dataset"
msgstr "Wählen Sie ein Bild aus diesem Datensatz"

# | msgid "" "There is no repository to show: only public GitHub repositories,
# | such as " "https://github.com/ckan/ckan, are supported."
#. TRANSLATORS: {hosts} is a list of this site's own Git servers.
#: ckanext/webpageviewplus/validators.py:342
msgid ""
"Not the address of a repository on GitHub, GitLab, Codeberg, Bitbucket or"
" {hosts}, such as https://github.com/ckan/ckan"
msgstr ""
"Keine Adresse eines Repositorys auf GitHub, GitLab, Codeberg, Bitbucket "
"oder {hosts}, etwa https://github.com/ckan/ckan"

# | msgid "Not a GitHub repository's address, such as
# | https://github.com/ckan/ckan"
#: ckanext/webpageviewplus/validators.py:346
msgid ""
"Not the address of a repository on GitHub, GitLab, Codeberg or Bitbucket,"
" such as https://github.com/ckan/ckan"
msgstr ""
"Keine Adresse eines Repositorys auf GitHub, GitLab, Codeberg oder "
"Bitbucket, etwa https://github.com/ckan/ckan"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:4
msgid "Strict: static HTML, no scripts"
msgstr "Streng: statisches HTML, keine Skripte"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:5
msgid "Interactive: scripts, forms, popups and downloads, no storage"
msgstr "Interaktiv: Skripte, Formulare, Pop-ups und Downloads, kein Speicher"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:6
msgid "External: a trusted third-party site, no sandbox"
msgstr "Extern: eine vertrauenswürdige Website Dritter, keine Sandbox"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:7
msgid ""
"External: a trusted third-party site, no sandbox (runs as Interactive for"
" now)"
msgstr ""
"Extern: eine vertrauenswürdige Website Dritter, keine Sandbox (läuft "
"vorerst als Interaktiv)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:8
msgid "Data Schematic: qsv Data Schematics"
msgstr "Data Schematic: qsv Data Schematics"

#. how the embedded page's height is set; "Auto" means the page reports its own
#. height.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:12
msgid "Auto"
msgstr "Automatisch"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:13
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:7
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:7
msgid "Fixed (px)"
msgstr "Fest (px)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:14
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:8
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:8
msgid "Share of the window height, in percent"
msgstr "Anteil der Fensterhöhe, in Prozent"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:15
msgid "Aspect ratio (e.g. 16/9)"
msgstr "Seitenverhältnis (z. B. 16/9)"

#. names of security presets, as in "the External preset".
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:20
msgid "Strict"
msgstr "Streng"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:21
msgid "Interactive"
msgstr "Interaktiv"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:22
msgid "External"
msgstr "Extern"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:23
msgid "Data Schematic"
msgstr "Data Schematic"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:29
msgid "Web Page url"
msgstr "URL der Webseite"

# | msgid "eg. http://example.com  (if blank uses resource url)"
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:29
msgid "eg. https://example.com  (if blank uses resource url)"
msgstr ""
"z. B. https://example.com  (wenn leer, wird die URL der Ressource "
"verwendet)"

# from
#. {services} is a comma-separated list of service names, such as "YouTube,
#. Vimeo,
#. Datawrapper".
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:32
msgid ""
"Leave blank to show this resource's own address. Paste a link from "
"{services} and the form suggests its embed address and settings."
msgstr ""
"Leer lassen, um die eigene Adresse dieser Ressource anzuzeigen. Fügen Sie"
" einen Link von {services} ein, und das Formular schlägt die "
"Einbettungsadresse und die passenden Einstellungen vor."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:33
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:19
msgid "This site accepts pages from these hosts only: {hosts}."
msgstr "Diese Website akzeptiert nur Seiten von diesen Hosts: {hosts}."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:38
msgid ""
"In Chrome and Edge, this PDF stays blank with this preset: they don't "
"show PDFs in a sandbox."
msgstr "In Chrome und Edge bleibt dieses PDF mit diesem Profil leer: Sie zeigen keine PDFs in einer Sandbox an."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:40
msgid "Use a PDF (Plus) view instead."
msgstr "Verwenden Sie stattdessen eine Ansicht PDF (Plus)."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:42
msgid "If you trust the site the PDF comes from, the External preset shows it."
msgstr "Wenn Sie der Website vertrauen, von der das PDF stammt, zeigt das Profil Extern es an."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:44
msgid ""
"Link to the PDF instead, or ask your site administrator about the PDF "
"(Plus) view."
msgstr "Verlinken Sie stattdessen auf das PDF oder fragen Sie die Administration Ihrer Website nach der Ansicht PDF (Plus)."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:48
msgid ""
"This resource is a PDF: the PDF (Plus) view shows it better, on phones "
"too."
msgstr ""
"Diese Ressource ist ein PDF: Die Ansicht PDF (Plus) zeigt es besser, auch"
" auf Smartphones."

# | msgid "" "{service} only works with the {preset} preset, which this site
# | runs as " "Interactive until it serves uploads from a separate content
# | origin, so it" " won't play here yet."
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:52
#, python-brace-format
msgid ""
"{service} only works with the {preset} preset, which this site runs as "
"Interactive until it has a separate domain for uploads, so it won't play "
"here yet. Ask your site administrator."
msgstr ""
"{service} funktioniert nur mit dem Profil {preset}, das diese Website als"
" Interaktiv ausführt, bis sie eine eigene Domain für Uploads hat. Daher "
"läuft es hier noch nicht. Fragen Sie die Administration Ihrer Website."

# | msgid "" "{service} only works with the {preset} preset, which this site
# | runs as " "Interactive until it serves uploads from a separate content
# | origin, so it" " won't play here yet."
# | runs as " "Interactive until it has a separate domain for uploads, so it
# | won't play " "here yet. Ask your site administrator."
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:53
#, python-brace-format
msgid ""
"{service} only works with the {preset} preset, which this site runs as "
"Interactive while it doesn't sandbox downloads, so it won't play here. "
"Ask your site administrator."
msgstr ""
"{service} funktioniert nur mit dem Profil {preset}, das diese Website als"
" Interaktiv ausführt, solange sie Downloads nicht in einer Sandbox "
"ausliefert. Daher läuft es hier nicht. Fragen Sie die Administration "
"Ihrer Website."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:54
#, python-brace-format
msgid ""
"{service} only works with the {preset} preset, which this site doesn't "
"allow."
msgstr ""
"{service} funktioniert nur mit dem Profil {preset}, das diese Website "
"nicht erlaubt."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:55
#, python-brace-format
msgid ""
"{service} embeds come from {host}, which isn't on this site's list of "
"allowed hosts."
msgstr ""
"Einbettungen von {service} kommen von {host}, der nicht auf der Liste der"
" erlaubten Hosts dieser Website steht."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:56
msgid ""
"{service}'s viewer fetches the file from its own servers, so it can't "
"show a file in a private dataset."
msgstr ""
"Der Viewer von {service} lädt die Datei von seinen eigenen Servern, daher"
" kann er keine Datei aus einem privaten Datensatz anzeigen."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:57
msgid ""
"{service} doesn't let its pages show inside other sites, so this view "
"would stay blank. Use the page's embed or share address if it has one, or"
" link to it instead."
msgstr ""
"{service} lässt seine Seiten nicht in anderen Websites anzeigen, daher "
"bliebe diese Ansicht leer. Verwenden Sie die Einbettungs- oder Teilen-"
"Adresse der Seite, falls vorhanden, oder verlinken Sie sie stattdessen."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:68
#, python-brace-format
msgid ""
"This is a {service} page. Use its embed address and the settings its "
"embed needs?"
msgstr ""
"Dies ist eine {service}-Seite. Ihre Einbettungsadresse und die "
"Einstellungen verwenden, die die Einbettung braucht?"

#. a button accepting the suggested embed address and settings.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:70
msgid "Use them"
msgstr "Verwenden"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:71
#, python-brace-format
msgid ""
"Using the embed address and settings for {service}. Save the view to keep"
" them."
msgstr ""
"Einbettungsadresse und Einstellungen für {service} werden verwendet. "
"Speichern Sie die Ansicht, um sie zu behalten."

# | msgid "" "This site refuses to be embedded ({reason}), so the view will
# show
# | an " "error. Consider linking to it instead."
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:85
#, python-brace-format
msgid ""
"This site refuses to be embedded, so the view will show an error. "
"Consider linking to it instead."
msgstr ""
"Diese Website lässt sich nicht einbetten, daher zeigt die Ansicht einen "
"Fehler. Verlinken Sie sie besser."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:86
msgid "Couldn't check whether this site allows embedding."
msgstr "Es konnte nicht geprüft werden, ob diese Website das Einbetten erlaubt."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:90
msgid "Security preset"
msgstr "Sicherheitsprofil"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:99
msgid ""
"Choose the most restrictive preset that works: if the page stays blank or"
" broken, try the next one."
msgstr ""
"Wählen Sie das restriktivste Profil, das funktioniert: Bleibt die Seite "
"leer oder fehlerhaft, versuchen Sie das nächste."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:100
msgid "External turns the sandbox off, so use it only for sites you trust."
msgstr ""
"Extern schaltet die Sandbox ab, verwenden Sie es also nur für "
"vertrauenswürdige Websites."

# | msgid "" "This preset needs uploaded HTML to be served from a separate
# | content " "origin, which this site doesn't have yet, so the view runs as "
# | "Interactive."
# | msgid "" "This preset needs a separate domain for uploads, which this site
# | doesn't " "have yet, so the view runs as Interactive. Ask your site
# | administrator if" " you need it."
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:108
msgid ""
"This upload is kept where the separate domain for uploads can't serve it "
"from, so the view runs as Interactive."
msgstr ""
"Dieser Upload liegt an einem Ort, von dem die eigene Domain für Uploads "
"ihn nicht ausliefern kann, daher läuft die Ansicht als Interaktiv."

# | msgid "" "This preset needs uploaded HTML to be served from a separate
# | content " "origin, which this site doesn't have yet, so the view runs as "
# | "Interactive."
# | msgid "" "This preset needs a separate domain for uploads, which this site
# | doesn't " "have yet, so the view runs as Interactive. Ask your site
# | administrator if" " you need it."
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:110
msgid ""
"External needs this site to sandbox downloads, which it has turned off, "
"so the view runs as Interactive. Ask your site administrator if you need "
"it."
msgstr ""
"Extern setzt voraus, dass diese Website Downloads in einer Sandbox "
"ausliefert, was sie abgeschaltet hat, daher läuft die Ansicht als "
"Interaktiv. Fragen Sie die Administration Ihrer Website, wenn Sie es "
"brauchen."

# | msgid "" "This preset needs uploaded HTML to be served from a separate
# | content " "origin, which this site doesn't have yet, so the view runs as "
# | "Interactive."
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:112
msgid ""
"This preset needs a separate domain for uploads, which this site doesn't "
"have yet, so the view runs as Interactive. Ask your site administrator if"
" you need it."
msgstr ""
"Dieses Profil braucht eine eigene Domain für Uploads, die diese Website "
"noch nicht hat, daher läuft die Ansicht als Interaktiv. Fragen Sie die "
"Administration Ihrer Website, wenn Sie es brauchen."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:114
msgid "Charts, the Tour and Explore work, but maps stay blank."
msgstr "Diagramme, die Tour und Explore funktionieren, aber Karten bleiben leer."

# | msgid "" "This view's sandbox would let scripts keep a real origin, which
# | isn't " "allowed here, so it runs as Strict."
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:118
msgid ""
"These sandbox settings could let the page use visitors' logins on this "
"site, which isn't allowed, so the view runs as Strict."
msgstr ""
"Diese Sandbox-Einstellungen könnten der Seite erlauben, die Anmeldungen "
"der Besucher auf dieser Website zu nutzen, was nicht erlaubt ist, daher "
"läuft die Ansicht als Streng."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:121
msgid ""
"In Chrome and Edge, this site loads pages with this preset without the "
"visitor's cookies or saved data, so logins inside the page and sign-in "
"popups won't work."
msgstr ""
"In Chrome und Edge lädt diese Website Seiten mit diesem Profil ohne die "
"Cookies und gespeicherten Daten der Besucher, daher funktionieren "
"Anmeldungen innerhalb der Seite und Anmelde-Pop-ups nicht."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:125
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:24
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:18
msgid "Height"
msgstr "Höhe"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:128
msgid "Preset's default"
msgstr "Wie im Profil"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:134
msgid ""
"Auto fits pages that report their own height, such as qsv Data "
"Schematics. Other pages keep a fixed fallback height."
msgstr ""
"Automatisch passt sich Seiten an, die ihre eigene Höhe melden, etwa qsv "
"Data Schematics. Andere Seiten behalten eine feste Ersatzhöhe."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:138
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:35
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:29
msgid "Height value"
msgstr "Höhenwert"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:138
msgid "eg. 600, 80 or 16/9"
msgstr "z. B. 600, 80 oder 16/9"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:139
msgid ""
"Pixels for Fixed, a number from 1 to 100 for a share of the window, or a "
"ratio such as 16/9. Auto and the preset's default need no value."
msgstr ""
"Pixel für Fest, eine Zahl von 1 bis 100 für einen Anteil am Fenster oder "
"ein Verhältnis wie 16/9. Automatisch und Wie im Profil brauchen keinen "
"Wert."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:144
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:41
msgid "Thumbnail in the resource list"
msgstr "Vorschaubild in der Ressourcenliste"

#. no thumbnail image chosen (the image, feminine in some languages).
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:148
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:45
msgid "None"
msgstr "Keines"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:155
msgid ""
"An image in this dataset (PNG, JPEG, WebP or GIF), uploaded or linked, "
"shown small beside this resource in the dataset's list. With None, the "
"page's own preview image, a well-known service's logo or the format icon "
"shows."
msgstr ""
"Ein Bild in diesem Datensatz (PNG, JPEG, WebP oder GIF), hochgeladen oder"
" verlinkt, klein neben dieser Ressource in der Liste des Datensatzes "
"angezeigt. Mit Keines erscheint das eigene Vorschaubild der Seite, das "
"Logo eines bekannten Dienstes oder das Formatsymbol."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:157
msgid ""
"An image uploaded to this dataset (PNG, JPEG, WebP or GIF), shown small "
"beside this resource in the dataset's list. With None, a well-known "
"service's logo or the format icon shows."
msgstr ""
"Ein in diesen Datensatz hochgeladenes Bild (PNG, JPEG, WebP oder GIF), "
"klein neben dieser Ressource in der Liste des Datensatzes angezeigt. Mit "
"Keines erscheint das Logo eines bekannten Dienstes oder das Formatsymbol."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:164
msgid "Don't make a thumbnail automatically"
msgstr "Kein Vorschaubild automatisch erstellen"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:166
msgid ""
"Otherwise, when no image is chosen above, this site fetches the image the"
" page names for link previews, once when the view is saved, and shows a "
"small copy."
msgstr ""
"Andernfalls ruft diese Website, wenn oben kein Bild gewählt ist, das Bild"
" ab, das die Seite für Linkvorschauen angibt, einmal beim Speichern der "
"Ansicht, und zeigt eine kleine Kopie davon."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:168
msgid ""
"Otherwise, when no image is chosen above, an Office file uploaded to this"
" dataset shows the preview picture saved inside it."
msgstr ""
"Andernfalls zeigt eine in diesen Datensatz hochgeladene Office-Datei, "
"wenn oben kein Bild gewählt ist, das in ihr gespeicherte Vorschaubild."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:177
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:71
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:36
msgid "Hide the control bar (Open in new tab, Fullscreen, Reload)"
msgstr "Steuerleiste ausblenden (In neuem Tab öffnen, Vollbild, Neu laden)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:178
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:72
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:37
msgid ""
"On phones and at high zoom, Open in new tab still shows, so visitors can "
"always reach the page."
msgstr ""
"Auf Smartphones und bei starker Vergrößerung bleibt In neuem Tab öffnen "
"sichtbar, damit Besucher die Seite immer erreichen."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:182
msgid "Ask before loading a page from another site"
msgstr "Vor dem Laden einer Seite von einer anderen Website fragen"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:183
msgid ""
"Visitors see a card naming the site, and nothing loads from it until they"
" choose Load. Uploads and pages on this site load as usual."
msgstr ""
"Besucher sehen eine Karte mit dem Namen der Website, und nichts wird von "
"dort geladen, bis sie Laden wählen. Uploads und Seiten dieser Website "
"laden wie gewohnt."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:188
msgid "Count visits (daily totals only, nothing about visitors; the view says so)"
msgstr ""
"Besuche zählen (nur Tagessummen, nichts über Besucher; die Ansicht weist "
"darauf hin)"

#. view counts as "label: number" pairs, so no plural forms are needed.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:194
#, python-brace-format
msgid ""
"Last 30 days. Shown: {impressions}. Seen: {seen}. Loaded: {loaded}. Used:"
" {engaged}. Failed: {failed}."
msgstr ""
"Letzte 30 Tage. Angezeigt: {impressions}. Gesehen: {seen}. Geladen: "
"{loaded}. Genutzt: {engaged}. Fehlgeschlagen: {failed}."

#. heading of the advanced (sysadmin-only) settings.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:203
msgid "Advanced"
msgstr "Erweitert"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:204
msgid ""
"Each field replaces the preset's value; leave it blank to keep the "
"preset's. A sandbox with both allow-scripts and allow-same-origin is "
"refused wherever it could let a page act as this site."
msgstr ""
"Jedes Feld ersetzt den Wert des Profils; leer lassen, um den Wert des "
"Profils zu behalten. Eine Sandbox mit allow-scripts und allow-same-origin"
" zugleich wird überall abgelehnt, wo sie eine Seite als diese Website "
"handeln lassen könnte."

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:205
msgid "Sandbox tokens (replace the preset's)"
msgstr "Sandbox-Tokens (ersetzen die des Profils)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:205
msgid "eg. allow-scripts allow-popups"
msgstr "z. B. allow-scripts allow-popups"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:206
msgid "Allowed features (replace the preset's)"
msgstr "Erlaubte Funktionen (ersetzen die des Profils)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:206
msgid "eg. fullscreen; clipboard-write"
msgstr "z. B. fullscreen; clipboard-write"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:208
msgid "Referrer policy"
msgstr "Referrer-Richtlinie"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:211
msgid "Site default"
msgstr "Wie auf der Website"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:12
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:144
msgid ""
"This PDF can't be shown: the site needs a separate domain for uploaded "
"content."
msgstr ""
"Dieses PDF kann nicht angezeigt werden: Die Website benötigt eine eigene "
"Domain für hochgeladene Inhalte."

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:15
msgid "PDF url"
msgstr "PDF-URL"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:15
msgid "eg. https://example.com/report.pdf  (if blank uses resource url)"
msgstr ""
"z. B. https://example.com/report.pdf  (wenn leer, wird die URL der "
"Ressource verwendet)"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:17
msgid ""
"Leave blank to show this resource's own file. A PDF on another site is "
"fetched by this site and shown from here, so visitors never contact that "
"site."
msgstr ""
"Leer lassen, um die eigene Datei dieser Ressource anzuzeigen. Ein PDF auf"
" einer anderen Website wird von dieser Website abgerufen und von hier aus"
" angezeigt, sodass Besucher diese Website nie kontaktieren."

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:18
msgid "Files on other sites are shown up to {size} MB."
msgstr "Dateien anderer Websites werden bis {size} MB angezeigt."

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:35
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:29
msgid "eg. 800 or 80"
msgstr "z. B. 800 oder 80"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:36
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:30
msgid ""
"Pixels for Fixed, or a number from 1 to 100 for a share of the window. "
"Blank is 800 pixels."
msgstr ""
"Pixel für Fest oder eine Zahl von 1 bis 100 für einen Anteil des "
"Fensters. Leer bedeutet 800 Pixel."

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:46
msgid "The PDF's first page"
msgstr "Die erste Seite des PDFs"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:52
msgid ""
"An image in this dataset (PNG, JPEG, WebP or GIF), shown small beside "
"this resource in the dataset's list. With None, the format icon shows."
msgstr ""
"Ein Bild in diesem Datensatz (PNG, JPEG, WebP oder GIF), klein neben "
"dieser Ressource in der Liste des Datensatzes angezeigt. Bei „Keines“ "
"wird das Formatsymbol angezeigt."

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:53
msgid ""
"The PDF's first page is drawn in your browser when you choose it, and "
"again when you edit the view after an uploaded file has changed, or every"
" time for a PDF linked from another site."
msgstr ""
"Die erste Seite des PDFs wird in Ihrem Browser gezeichnet, wenn Sie sie "
"wählen, und erneut, wenn Sie die Ansicht bearbeiten, nachdem sich eine "
"hochgeladene Datei geändert hat, oder jedes Mal bei einem PDF, das von "
"einer anderen Website verlinkt ist."

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:60
msgid "Drawing the first page…"
msgstr "Die erste Seite wird gezeichnet…"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:61
msgid "The first page is ready. Save the view to use it."
msgstr ""
"Die erste Seite ist fertig. Speichern Sie die Ansicht, um sie zu "
"verwenden."

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:62
msgid ""
"Couldn't draw the first page. Check the PDF shows in the view, then try "
"again."
msgstr ""
"Die erste Seite konnte nicht gezeichnet werden. Prüfen Sie, ob das PDF in"
" der Ansicht erscheint, und versuchen Sie es erneut."

# | msgid "Save the view first, then choose the first page again."
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:63
msgid "Save the view, then edit it again to draw the first page."
msgstr ""
"Speichern Sie die Ansicht und bearbeiten Sie sie dann erneut, um die "
"erste Seite zu zeichnen."

#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:11
msgid "Repository url"
msgstr "URL des Repositorys"

# | msgid "eg. https://github.com/ckan/ckan  (if blank uses resource url)"
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:11
msgid ""
"eg. https://github.com/ckan/ckan or https://gitlab.com/gitlab-org/gitlab"
"  (if blank uses resource url)"
msgstr ""
"z. B. https://github.com/ckan/ckan oder https://gitlab.com/gitlab-"
"org/gitlab  (wenn leer, wird die URL der Ressource verwendet)"

# | msgid "" "Leave blank to show the repository this resource links to, or
# | enter " "another repository or branch to show instead. A public GitHub "
# | "repository's name, description, files and README are fetched by this
# site"
# | " and shown here, as GitHub's pages can't be embedded. Add /tree/<branch>
# "
# | "for a branch other than the default."
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_form.html:13
msgid ""
"Leave blank to show the repository this resource links to, or enter "
"another repository or branch to show instead. A public repository's name,"
" description, files and README are fetched by this site and shown here, "
"as the pages of GitHub, GitLab, Codeberg and Bitbucket can't be embedded."
" For a branch other than the default, use the address of the branch's "
"page."
msgstr ""
"Leer lassen, um das Repository zu zeigen, auf das diese Ressource "
"verlinkt, oder ein anderes Repository oder einen anderen Branch eingeben,"
" der stattdessen gezeigt wird. Name, Beschreibung, Dateien und README "
"eines öffentlichen Repositorys ruft diese Website ab und zeigt sie hier, "
"da sich die Seiten von GitHub, GitLab, Codeberg und Bitbucket nicht "
"einbetten lassen. Für einen anderen Branch als den Standard die Adresse "
"der Seite des Branches verwenden."

#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:16
msgid "Archived"
msgstr "Archiviert"

#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:18
msgid "{count} star"
msgid_plural "{count} stars"
msgstr[0] "{count} Stern"
msgstr[1] "{count} Sterne"

#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:19
msgid "{count} fork"
msgid_plural "{count} forks"
msgstr[0] "{count} Fork"
msgstr[1] "{count} Forks"

#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:20
msgid "Updated {date}"
msgstr "Aktualisiert am {date}"

#. the branch whose files are listed, such as "main".
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:22
msgid "Branch: {ref}"
msgstr "Branch: {ref}"

#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:24
msgid "Files"
msgstr "Dateien"

#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:29
msgid "More files on {site}"
msgstr "Weitere Dateien auf {site}"

# | msgid "" "This site has used up its requests to GitHub for now, so the
# | repository " "can't be shown here. Try again later."
#. {site} is a code hosting site, such as GitHub or GitLab.
#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:40
msgid ""
"This site has used up its requests to {site} for now, so the repository "
"can't be shown here. Try again later."
msgstr ""
"Diese Website hat ihre Anfragen an {site} vorerst aufgebraucht, daher "
"kann das Repository hier nicht angezeigt werden. Versuchen Sie es später "
"erneut."

#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:42
msgid "This repository wasn't found, or it isn't public."
msgstr "Dieses Repository wurde nicht gefunden oder ist nicht öffentlich."

#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:44
msgid "This address isn't a repository this view can show."
msgstr "Diese Adresse ist kein Repository, das diese Ansicht zeigen kann."

#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:46
msgid "The repository couldn't be loaded. Try again later."
msgstr ""
"Das Repository konnte nicht geladen werden. Versuchen Sie es später "
"erneut."

#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:49
msgid "Open on {site}"
msgstr "Auf {site} öffnen"

#: ckanext/webpageviewplus/templates/webpageviewplus/repo_page.html:49
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:17
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:114
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:140
msgid "Open in new tab"
msgstr "In neuem Tab öffnen"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:8
msgid ""
"This page can't be shown here: it's served over http://, which browsers "
"block inside https:// sites."
msgstr ""
"Diese Seite kann hier nicht angezeigt werden: Sie wird über http:// "
"ausgeliefert, was Browser innerhalb von https://-Websites blockieren."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:10
msgid ""
"This page is gone: {host} said it no longer exists when the view was last"
" checked."
msgstr ""
"Diese Seite gibt es nicht mehr: {host} meldete bei der letzten Prüfung "
"der Ansicht, dass sie nicht mehr existiert."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:12
msgid ""
"Microsoft's viewer can't open files in a private dataset, so this view "
"can't show it."
msgstr ""
"Der Viewer von Microsoft kann keine Dateien aus einem privaten Datensatz "
"öffnen, daher kann diese Ansicht sie nicht anzeigen."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:14
#, python-brace-format
msgid "{host} doesn't allow its pages to be shown inside other sites."
msgstr ""
"{host} erlaubt nicht, dass seine Seiten innerhalb anderer Websites "
"angezeigt werden."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:28
msgid "Skip embedded content"
msgstr "Eingebettete Inhalte überspringen"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:33
#, python-brace-format
msgid "Interact with {title}"
msgstr "Mit {title} interagieren"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:33
msgid "Tap to interact"
msgstr "Zum Interagieren tippen"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:59
#, python-brace-format
msgid "This view loads content from {host}."
msgstr "Diese Ansicht lädt Inhalte von {host}."

# it
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:61
msgid ""
"Loading it lets {host} know you are visiting this site, and it may "
"recognise you if you are signed in there."
msgstr ""
"Beim Laden erfährt {host}, dass Sie diese Website besuchen, und erkennt "
"Sie womöglich, wenn Sie dort angemeldet sind."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:62
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:107
msgid "Privacy policy"
msgstr "Datenschutzerklärung"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:65
msgid "Not loaded, to save data."
msgstr "Nicht geladen, um Daten zu sparen."

#. a button loading the embedded page; {size} is its file size, e.g. "1.2 MB".
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:69
#, python-brace-format
msgid "Load ({size})"
msgstr "Laden ({size})"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:69
msgid "Load"
msgstr "Laden"

#. a button that loads the page and remembers, in this browser, to load pages
#. from
#. {host} without asking.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:74
#, python-brace-format
msgid "Always load from {host}"
msgstr "Immer von {host} laden"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:81
msgid "Content from {host} loads without asking in this browser."
msgstr "Inhalte von {host} werden in diesem Browser ohne Nachfrage geladen."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:83
msgid "You will be asked again next time."
msgstr "Sie werden beim nächsten Mal wieder gefragt."

#. a button that forgets the choice to always load pages from a site.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:85
msgid "Ask me again"
msgstr "Wieder fragen"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:97
#, python-brace-format
msgid "{title} loaded"
msgstr "{title} geladen"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:100
msgid "This page connects to"
msgstr "Diese Seite verbindet sich mit"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:106
msgid "This view counts visits."
msgstr "Diese Ansicht zählt Besuche."

#. accessible name of the toolbar under an embedded web page.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:112
msgid "Embedded page"
msgstr "Eingebettete Seite"

#. "Expand" makes the embedded page fill the window; "Fullscreen" fills the
#. screen.
#. Buttons.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:121
msgid "Expand"
msgstr "Vergrößern"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:121
msgid "Fullscreen"
msgstr "Vollbild"

#. a button leaving the expanded (full-window) view.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:123
msgid "Close"
msgstr "Schließen"

#. a button reloading the embedded page.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:127
msgid "Reload"
msgstr "Neu laden"

#. a button opening the device's share sheet for this page.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:133
msgid "Share"
msgstr "Teilen"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:146
msgid ""
"There is no PDF to show: only uploaded files and http:// or https:// "
"links are supported."
msgstr ""
"Es gibt kein PDF zum Anzeigen: Nur hochgeladene Dateien und http://- oder"
" https://-Links werden unterstützt."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:148
msgid "Save the view to see the PDF."
msgstr "Speichern Sie die Ansicht, um das PDF zu sehen."

# | msgid "" "There is no repository to show: only public GitHub repositories,
# | such as " "https://github.com/ckan/ckan, are supported."
#. {hosts} is a list of this site's own Git servers, such as "git.example.org,
#. gitlab.example.org".
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:152
msgid ""
"There is no repository to show: only public repositories on GitHub, "
"GitLab, Codeberg, Bitbucket and {hosts}, such as "
"https://github.com/ckan/ckan, are supported."
msgstr ""
"Es gibt kein Repository zum Anzeigen: Nur öffentliche Repositorys auf "
"GitHub, GitLab, Codeberg, Bitbucket und {hosts} wie "
"https://github.com/ckan/ckan werden unterstützt."

# | msgid "" "There is no repository to show: only public GitHub repositories,
# | such as " "https://github.com/ckan/ckan, are supported."
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:154
msgid ""
"There is no repository to show: only public repositories on GitHub, "
"GitLab, Codeberg and Bitbucket, such as https://github.com/ckan/ckan, are"
" supported."
msgstr ""
"Es gibt kein Repository zum Anzeigen: Nur öffentliche Repositorys auf "
"GitHub, GitLab, Codeberg und Bitbucket wie https://github.com/ckan/ckan "
"werden unterstützt."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:157
msgid "Save the view to see the repository."
msgstr "Speichern Sie die Ansicht, um das Repository zu sehen."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:159
msgid ""
"This page can't be embedded: its host isn't on this site's list of "
"allowed hosts."
msgstr ""
"Diese Seite kann nicht eingebettet werden: Ihr Host steht nicht auf der "
"Liste der erlaubten Hosts dieser Website."

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:161
msgid ""
"This page cannot be embedded: only http:// and https:// URLs are "
"supported."
msgstr ""
"Diese Seite kann nicht eingebettet werden: Nur http://- und https://-URLs"
" werden unterstützt."

