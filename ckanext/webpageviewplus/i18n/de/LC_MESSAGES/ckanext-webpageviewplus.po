msgstr "Kein Bildschirmfoto für diese Ansicht"

# | msgid "The first page is ready. Save the view to use it."
# | msgid "Draw the first page again in the view's form."
#: ckanext/webpageviewplus/manage.py:691
msgid "Drawn in the view's form"
msgstr "Wird im Formular der Ansicht gezeichnet"

#: ckanext/webpageviewplus/manage.py:692
msgid "Nothing to do"
msgstr "Nichts zu tun"

# | msgid "PDF view not found"
# | msgid "View not found"
#: ckanext/webpageviewplus/manage.py:693
msgid "Not found"
msgstr "Nicht gefunden"

# | msgid "the page couldn't be reached"
#: ckanext/webpageviewplus/manage.py:694
