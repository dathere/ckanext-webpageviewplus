# | msgid "Automatic thumbnails are on for this view."
# | msgid "Not taken for this view."
#: ckanext/webpageviewplus/manage.py:678
msgid "No screenshot for this view"
msgstr "このビューにはスクリーンショットなし"

# | msgid "The first page is ready. Save the view to use it."
# | msgid "Draw the first page again in the view's form."
#: ckanext/webpageviewplus/manage.py:679
msgid "Drawn in the view's form"
