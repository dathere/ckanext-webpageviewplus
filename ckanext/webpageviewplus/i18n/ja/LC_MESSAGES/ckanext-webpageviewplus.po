#: ckanext/webpageviewplus/actions.py:204
msgid "Must be a whole number"
msgstr "整数で指定してください"

#: ckanext/webpageviewplus/actions.py:238
msgid "PDF view not found"
msgstr "PDF ビューが見つかりません"

#: ckanext/webpageviewplus/actions.py:267
msgid "Thumbnails aren't enabled on this site"
msgstr "このサイトではサムネイルが有効になっていません"

#: ckanext/webpageviewplus/actions.py:277
#: ckanext/webpageviewplus/actions.py:280
msgid "Not a usable image"
msgstr "使用できる画像ではありません"

#: ckanext/webpageviewplus/plugin.py:142
msgid "Website (Plus)"
msgstr "ウェブサイト (Plus)"

#: ckanext/webpageviewplus/plugin.py:164
msgid "Website"
msgstr "ウェブサイト"

#: ckanext/webpageviewplus/plugin.py:268
msgid "Embedded web page"
msgstr "埋め込みウェブページ"

#: ckanext/webpageviewplus/plugin.py:470
msgid "PDF (Plus)"
msgstr "PDF (Plus)"

#: ckanext/webpageviewplus/plugin.py:483
msgid "PDF"
msgstr "PDF"

#: ckanext/webpageviewplus/plugin.py:545
msgid "PDF document"
msgstr "PDF ドキュメント"

#: ckanext/webpageviewplus/validators.py:19
msgid "Web Page url must be an http:// or https:// URL"
msgstr "ウェブページの URL は http:// または https:// で始まる必要があります"

#: ckanext/webpageviewplus/validators.py:28
msgid "Preset is not one of the allowed presets"
msgstr "このプリセットは許可されていません"

#: ckanext/webpageviewplus/validators.py:34
#: ckanext/webpageviewplus/validators.py:222
msgid "Unknown height mode"
msgstr "不明な高さモードです"

#: ckanext/webpageviewplus/validators.py:47
#, python-brace-format
msgid "Unknown sandbox token: {tokens}"
msgid_plural "Unknown sandbox tokens: {tokens}"
msgstr[0] "不明なサンドボックストークン: {tokens}"

#: ckanext/webpageviewplus/validators.py:62
#, python-brace-format
msgid "This feature can't be granted: {features}"
msgid_plural "These features can't be granted: {features}"
msgstr[0] "次の機能は許可できません: {features}"

#: ckanext/webpageviewplus/validators.py:70
msgid "Unknown referrer policy"
msgstr "不明なリファラーポリシーです"

#: ckanext/webpageviewplus/validators.py:133
#: ckanext/webpageviewplus/validators.py:243
msgid "Height value doesn't fit the height mode"
msgstr "高さの値が高さモードに合っていません"

#: ckanext/webpageviewplus/validators.py:160
msgid ""
"External is for third-party sites: uploaded HTML always gets a sandbox. "
"Use Data Schematic or Interactive"
msgstr ""
"「外部」はサードパーティのサイト用です。アップロードされた HTML には常にサンドボックスが適用されます。「Data "
"Schematic」または「インタラクティブ」を使用してください"

#: ckanext/webpageviewplus/validators.py:173
#: ckanext/webpageviewplus/validators.py:255
msgid "This host isn't on the site's list of allowed hosts"
msgstr "このホストはサイトの許可ホスト一覧にありません"

#: ckanext/webpageviewplus/validators.py:186
msgid ""
"This frame can't let scripts keep a real origin: don't combine allow-"
"scripts with allow-same-origin. Pages on this site never may; other pages"
" may once uploaded HTML is served from a separate content origin"
msgstr ""
"このフレームでスクリプトに本来のオリジンを持たせることはできません。allow-scripts と allow-same-origin "
"を組み合わせないでください。このサイトのページでは常に不可です。他のページでは、アップロードされた HTML "
"が別のコンテンツオリジンから配信されるようになれば可能です"

#: ckanext/webpageviewplus/validators.py:215
msgid "Choose an image from this dataset"
msgstr "このデータセットの画像を選んでください"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:4
msgid "Strict: static HTML, no scripts"
msgstr "厳格: 静的 HTML、スクリプトなし"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:5
msgid "Interactive: scripts, forms, popups and downloads, no storage"
msgstr "インタラクティブ: スクリプト、フォーム、ポップアップ、ダウンロード可、ストレージなし"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:6
msgid "External: a trusted third-party site, no sandbox"
msgstr "外部: 信頼できるサードパーティのサイト、サンドボックスなし"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:7
msgid ""
"External: a trusted third-party site, no sandbox (runs as Interactive for"
" now)"
msgstr "外部: 信頼できるサードパーティのサイト、サンドボックスなし (現在はインタラクティブとして動作)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:8
msgid "Data Schematic: qsv Data Schematics"
msgstr "Data Schematic: qsv の Data Schematics"

#. how the embedded page's height is set; "Auto" means the page reports its own
#. height.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:12
msgid "Auto"
msgstr "自動"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:13
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:6
msgid "Fixed (px)"
msgstr "固定 (px)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:14
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:7
msgid "Share of the window height, in percent"
msgstr "ウィンドウの高さに対する割合 (パーセント)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:15
msgid "Aspect ratio (e.g. 16/9)"
msgstr "アスペクト比 (例: 16/9)"

#. names of security presets, as in "the External preset".
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:20
msgid "Strict"
msgstr "厳格"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:21
msgid "Interactive"
msgstr "インタラクティブ"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:22
msgid "External"
msgstr "外部"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:23
msgid "Data Schematic"
msgstr "Data Schematic"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:27
msgid "Web Page url"
msgstr "ウェブページの URL"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:27
msgid "eg. http://example.com  (if blank uses resource url)"
msgstr "例: http://example.com  (空欄の場合はリソースの URL を使用)"

# from
#. {services} is a comma-separated list of service names, such as "YouTube,
#. Vimeo,
#. Datawrapper".
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:30
msgid ""
"Leave blank to show this resource's own address. Paste a link from "
"{services} and the form suggests its embed address and settings."
msgstr ""
"空欄にすると、このリソース自体のアドレスを表示します。{services} "
"のリンクを貼り付けると、フォームが埋め込み用アドレスと必要な設定を提案します。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:31
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:17
msgid "This site accepts pages from these hosts only: {hosts}."
msgstr "このサイトでは次のホストのページのみ使用できます: {hosts}。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:42
#, python-brace-format
msgid ""
"This is a {service} page. Use its embed address and the settings its "
"embed needs?"
msgstr "{service} のページです。埋め込み用のアドレスと、埋め込みに必要な設定を使用しますか？"

#. a button accepting the suggested embed address and settings.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:44
msgid "Use them"
msgstr "使用する"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:45
#, python-brace-format
msgid ""
"Using the embed address and settings for {service}. Save the view to keep"
" them."
msgstr "{service} の埋め込み用アドレスと設定を使用しています。保持するにはビューを保存してください。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:46
#, python-brace-format
msgid ""
"{service} only works with the {preset} preset, which this site runs as "
"Interactive until it serves uploads from a separate content origin, so it"
" won't play here yet."
msgstr ""
"{service} "
"は「{preset}」プリセットでのみ動作します。このサイトでは、アップロードを別のコンテンツオリジンから配信するまで、このプリセットはインタラクティブとして動作するため、まだ再生できません。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:47
#, python-brace-format
msgid ""
"{service} only works with the {preset} preset, which this site doesn't "
"allow."
msgstr "{service} は「{preset}」プリセットでのみ動作しますが、このサイトではこのプリセットは許可されていません。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:48
#, python-brace-format
msgid ""
"{service} embeds come from {host}, which isn't on this site's list of "
"allowed hosts."
msgstr "{service} の埋め込みは {host} から配信されますが、このホストはこのサイトの許可ホスト一覧にありません。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:49
msgid ""
"{service}'s viewer fetches the file from its own servers, so it can't "
"show a file in a private dataset."
msgstr "{service} のビューアーは自社のサーバーからファイルを取得するため、非公開データセットのファイルは表示できません。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:55
#, python-brace-format
msgid ""
"This site refuses to be embedded ({reason}), so the view will show an "
"error. Consider linking to it instead."
msgstr "このサイトは埋め込みを拒否している ({reason}) ため、ビューにはエラーが表示されます。代わりにリンクを張ることを検討してください。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:56
msgid "Couldn't check whether this site allows embedding."
msgstr "このサイトが埋め込みを許可しているか確認できませんでした。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:60
msgid "Security preset"
msgstr "セキュリティプリセット"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:69
msgid ""
"Choose the most restrictive preset that works: if the page stays blank or"
" broken, try the next one."
msgstr "動作する中で最も制限の厳しいプリセットを選んでください。ページが空白のままか正しく表示されない場合は、次のプリセットを試してください。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:70
msgid "External turns the sandbox off, so use it only for sites you trust."
msgstr "外部はサンドボックスを無効にするため、信頼できるサイトにのみ使用してください。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:77
msgid ""
"This preset needs uploaded HTML to be served from a separate content "
"origin, which this site doesn't have yet, so the view runs as "
"Interactive."
msgstr ""
"このプリセットには、アップロードされた HTML "
"を別のコンテンツオリジンから配信する必要がありますが、このサイトにはまだないため、ビューはインタラクティブとして動作します。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:78
msgid "Charts, the Tour and Explore work, but maps stay blank."
msgstr "グラフ、ツアー、Explore は動作しますが、地図は空白のままです。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:82
msgid ""
"This view's sandbox would let scripts keep a real origin, which isn't "
"allowed here, so it runs as Strict."
msgstr "このビューのサンドボックスではスクリプトが本来のオリジンを持ててしまい、ここでは許可されていないため、厳格として動作します。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:85
msgid ""
"In Chrome and Edge, this site loads pages with this preset without the "
"visitor's cookies or saved data, so logins inside the page and sign-in "
"popups won't work."
msgstr ""
"Chrome と Edge では、このサイトはこのプリセットのページを訪問者の Cookie "
"や保存データなしで読み込むため、ページ内のログインやログイン用ポップアップは動作しません。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:89
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:22
msgid "Height"
msgstr "高さ"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:92
msgid "Preset's default"
msgstr "プリセットの既定値"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:98
msgid ""
"Auto fits pages that report their own height, such as qsv Data "
"Schematics. Other pages keep a fixed fallback height."
msgstr "自動は、qsv の Data Schematic のように自身の高さを通知するページに合わせます。それ以外のページは固定の予備の高さのままです。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:102
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:33
msgid "Height value"
msgstr "高さの値"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:102
msgid "eg. 600, 80 or 16/9"
msgstr "例: 600、80、16/9"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:103
msgid ""
"Pixels for Fixed, a number from 1 to 100 for a share of the window, or a "
"ratio such as 16/9. Auto and the preset's default need no value."
msgstr ""
"固定ではピクセル数、ウィンドウに対する割合では 1 から 100 の数値、または 16/9 "
"のような比率を入力します。自動とプリセットの既定値では値は不要です。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:108
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:39
msgid "Thumbnail in the resource list"
msgstr "リソース一覧のサムネイル"

#. no thumbnail image chosen (the image, feminine in some languages).
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:112
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:43
msgid "None"
msgstr "なし"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:119
msgid ""
"An image in this dataset (PNG, JPEG, WebP or GIF), uploaded or linked, "
"shown small beside this resource in the dataset's list. With None, the "
"page's own preview image, a well-known service's logo or the format icon "
"shows."
msgstr "このデータセットの画像（PNG、JPEG、WebP、GIF。アップロードまたはリンク）。データセットの一覧でこのリソースの横に小さく表示されます。「なし」の場合は、ページ自身のプレビュー画像、よく知られたサービスのロゴ、または形式のアイコンが表示されます。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:121
msgid ""
"An image uploaded to this dataset (PNG, JPEG, WebP or GIF), shown small "
"beside this resource in the dataset's list. With None, a well-known "
"service's logo or the format icon shows."
msgstr "このデータセットにアップロードされた画像（PNG、JPEG、WebP、GIF）。データセットの一覧でこのリソースの横に小さく表示されます。「なし」の場合は、よく知られたサービスのロゴか形式のアイコンが表示されます。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:126
msgid "Don't use the page's own preview image"
msgstr "ページ自身のプレビュー画像を使わない"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:128
msgid ""
"Otherwise, when no image is chosen above, this site fetches the image the"
" page names for link previews, once when the view is saved, and shows a "
"small copy."
msgstr "チェックしない場合、上で画像が選ばれていなければ、このサイトはページがリンクのプレビュー用に指定している画像を、ビューの保存時に一度だけ取得し、小さなコピーを表示します。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:130
msgid ""
"Otherwise, when no image is chosen above, an Office file uploaded to this"
" dataset shows the preview picture saved inside it."
msgstr ""
"そうでない場合、上で画像が選ばれていなければ、このデータセットにアップロードされた Office "
"ファイルは、ファイル内に保存されたプレビュー画像を表示します。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:139
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:69
msgid "Hide the control bar (Open in new tab, Fullscreen, Reload)"
msgstr "コントロールバーを隠す (新しいタブで開く、全画面、再読み込み)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:140
#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:70
msgid ""
"On phones and at high zoom, Open in new tab still shows, so visitors can "
"always reach the page."
msgstr "スマートフォンや高倍率のズームでは、「新しいタブで開く」が引き続き表示されるため、訪問者はいつでもページにアクセスできます。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:144
msgid "Ask before loading a page from another site"
msgstr "他のサイトのページを読み込む前に確認する"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:145
msgid ""
"Visitors see a card naming the site, and nothing loads from it until they"
" choose Load. Uploads and pages on this site load as usual."
msgstr "訪問者にはサイト名を示すカードが表示され、「読み込む」を選ぶまでそのサイトからは何も読み込まれません。アップロードとこのサイトのページは通常どおり読み込まれます。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:150
msgid "Count visits (daily totals only, nothing about visitors; the view says so)"
msgstr "訪問数を数える (日ごとの合計のみ、訪問者の情報は含まず、ビューにその旨を表示)"

#. view counts as "label: number" pairs, so no plural forms are needed.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:156
#, python-brace-format
msgid ""
"Last 30 days. Shown: {impressions}. Seen: {seen}. Loaded: {loaded}. Used:"
" {engaged}. Failed: {failed}."
msgstr ""
"過去 30 日間。表示: {impressions}。画面内: {seen}。読み込み: {loaded}。操作: {engaged}。失敗: "
"{failed}。"

#. heading of the advanced (sysadmin-only) settings.
#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:165
msgid "Advanced"
msgstr "詳細設定"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:166
msgid ""
"Each field replaces the preset's value; leave it blank to keep the "
"preset's. A sandbox with both allow-scripts and allow-same-origin is "
"refused wherever it could let a page act as this site."
msgstr ""
"各フィールドはプリセットの値を置き換えます。空欄のままにするとプリセットの値を使用します。allow-scripts と allow-same-"
"origin を両方含むサンドボックスは、ページがこのサイトとして動作できるおそれがある場合は拒否されます。"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:167
msgid "Sandbox tokens (replace the preset's)"
msgstr "サンドボックストークン (プリセットの値を置き換え)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:167
msgid "eg. allow-scripts allow-popups"
msgstr "例: allow-scripts allow-popups"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:168
msgid "Allowed features (replace the preset's)"
msgstr "許可する機能 (プリセットの値を置き換え)"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:168
msgid "eg. fullscreen; clipboard-write"
msgstr "例: fullscreen; clipboard-write"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:170
msgid "Referrer policy"
msgstr "リファラーポリシー"

#: ckanext/webpageviewplus/templates/webpageviewplus/form.html:173
msgid "Site default"
msgstr "サイトの既定値"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:11
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:140
msgid ""
"This PDF can't be shown: the site needs a separate domain for uploaded "
"content."
msgstr "この PDF は表示できません。アップロードされたコンテンツ用の別のドメインがサイトに必要です。"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:14
msgid "PDF url"
msgstr "PDF の URL"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:14
msgid "eg. https://example.com/report.pdf  (if blank uses resource url)"
msgstr "例: https://example.com/report.pdf (空の場合はリソースの URL を使用)"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:16
msgid ""
"Leave blank to show this resource's own file. A PDF on another site is "
"fetched by this site and shown from here, so visitors never contact that "
"site."
msgstr ""
"空のままにすると、このリソース自身のファイルを表示します。他のサイトにある PDF "
"はこのサイトが取得してここから表示するため、訪問者がそのサイトに接続することはありません。"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:33
msgid "eg. 800 or 80"
msgstr "例: 800 または 80"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:34
msgid ""
"Pixels for Fixed, or a number from 1 to 100 for a share of the window. "
"Blank is 800 pixels."
msgstr "固定の場合はピクセル数、ウィンドウに対する割合の場合は 1 から 100 の数値。空の場合は 800 ピクセルです。"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:44
msgid "The PDF's first page"
msgstr "PDF の最初のページ"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:50
msgid ""
"An image in this dataset (PNG, JPEG, WebP or GIF), shown small beside "
"this resource in the dataset's list. With None, the format icon shows."
msgstr ""
"このデータセット内の画像 (PNG、JPEG、WebP または "
"GIF)。データセットの一覧でこのリソースの横に小さく表示されます。「なし」の場合は形式のアイコンが表示されます。"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:51
msgid ""
"The PDF's first page is drawn in your browser when you choose it, and "
"again when you edit the view after an uploaded file has changed, or every"
" time for a PDF linked from another site."
msgstr ""
"PDF の最初のページは、選択したとき、アップロードされたファイルが変更された後にビューを編集したとき、そして他のサイトにリンクされた PDF "
"では毎回、お使いのブラウザで描画されます。"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:58
msgid "Drawing the first page…"
msgstr "最初のページを描画しています…"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:59
msgid "The first page is ready. Save the view to use it."
msgstr "最初のページの準備ができました。使用するにはビューを保存してください。"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:60
msgid ""
"Couldn't draw the first page. Check the PDF shows in the view, then try "
"again."
msgstr "最初のページを描画できませんでした。ビューに PDF が表示されることを確認してから、もう一度お試しください。"

#: ckanext/webpageviewplus/templates/webpageviewplus/pdf_form.html:61
msgid "Save the view first, then choose the first page again."
msgstr "まずビューを保存してから、もう一度最初のページを選択してください。"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:8
msgid ""
"This page can't be shown here: it's served over http://, which browsers "
"block inside https:// sites."
msgstr "このページはここでは表示できません。http:// で配信されており、https:// のサイト内ではブラウザーがブロックします。"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:10
#, python-brace-format
msgid "{host} doesn't allow its pages to be shown inside other sites."
msgstr "{host} は、他のサイト内でのページの表示を許可していません。"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:13
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:110
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:136
msgid "Open in new tab"
msgstr "新しいタブで開く"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:24
msgid "Skip embedded content"
msgstr "埋め込みコンテンツをスキップ"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:29
#, python-brace-format
msgid "Interact with {title}"
msgstr "{title} を操作"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:29
msgid "Tap to interact"
msgstr "タップして操作"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:55
#, python-brace-format
msgid "This view loads content from {host}."
msgstr "このビューは {host} のコンテンツを読み込みます。"

# it
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:57
msgid ""
"Loading it lets {host} know you are visiting this site, and it may "
"recognise you if you are signed in there."
msgstr "読み込むと、{host} はあなたがこのサイトを訪れていることを知り、ログインしている場合はあなたを識別できる可能性があります。"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:58
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:103
msgid "Privacy policy"
msgstr "プライバシーポリシー"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:61
msgid "Not loaded, to save data."
msgstr "データ節約のため読み込んでいません。"

#. a button loading the embedded page; {size} is its file size, e.g. "1.2 MB".
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:65
#, python-brace-format
msgid "Load ({size})"
msgstr "読み込む ({size})"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:65
msgid "Load"
msgstr "読み込む"

#. a button that loads the page and remembers, in this browser, to load pages
#. from
#. {host} without asking.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:70
#, python-brace-format
msgid "Always load from {host}"
msgstr "常に {host} から読み込む"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:77
msgid "Content from {host} loads without asking in this browser."
msgstr "このブラウザでは、{host} のコンテンツを確認なしで読み込みます。"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:79
msgid "You will be asked again next time."
msgstr "次回は再度確認します。"

#. a button that forgets the choice to always load pages from a site.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:81
msgid "Ask me again"
msgstr "再度確認する"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:93
#, python-brace-format
msgid "{title} loaded"
msgstr "{title} を読み込みました"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:96
msgid "This page connects to"
msgstr "このページの接続先"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:102
msgid "This view counts visits."
msgstr "このビューは訪問数を数えています。"

#. accessible name of the toolbar under an embedded web page.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:108
msgid "Embedded page"
msgstr "埋め込みページ"

#. "Expand" makes the embedded page fill the window; "Fullscreen" fills the
#. screen.
#. Buttons.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:117
msgid "Expand"
msgstr "拡大"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:117
msgid "Fullscreen"
msgstr "全画面"

#. a button leaving the expanded (full-window) view.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:119
msgid "Close"
msgstr "閉じる"

#. a button reloading the embedded page.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:123
msgid "Reload"
msgstr "再読み込み"

#. a button opening the device's share sheet for this page.
#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:129
msgid "Share"
msgstr "共有"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:142
msgid ""
"There is no PDF to show: only uploaded files and http:// or https:// "
"links are supported."
msgstr "表示する PDF がありません。アップロードされたファイルと http:// または https:// のリンクのみ対応しています。"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:144
msgid "Save the view to see the PDF."
msgstr "PDF を表示するにはビューを保存してください。"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:146
msgid ""
"This page can't be embedded: its host isn't on this site's list of "
"allowed hosts."
msgstr "このページは埋め込めません。ホストがこのサイトの許可ホスト一覧にありません。"

#: ckanext/webpageviewplus/templates/webpageviewplus/view.html:148
msgid ""
"This page cannot be embedded: only http:// and https:// URLs are "
"supported."
msgstr "このページは埋め込めません。http:// と https:// の URL のみ対応しています。"

